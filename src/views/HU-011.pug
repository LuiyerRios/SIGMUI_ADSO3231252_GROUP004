//- HU-011 · Help & Support (diseño original del equipo, conectado a layouts/app y Tailwind v4 compilado)
//- El título y el subtítulo los pinta el topbar con pageTitle / pageSubtitle.
extends layouts/app

block content
  div(class="w-full max-w-xl mx-auto flex flex-col gap-6")

    //- Encabezado principal
    div(class="text-center")
      h2(class="text-3xl sm:text-4xl font-extrabold text-ink tracking-tight")
        | Are you having#{' '}
        span(class="text-tech") any problems?
      p(class="text-muted text-xs sm:text-sm mt-2 font-medium leading-relaxed px-2")
        | Send us a message describing the issue you're experiencing, and our agents will resolve it quickly. You can also send us any suggestions.

    //- Tarjeta azul principal (#1A5292)
    div(class="w-full bg-[#1A5292] text-white p-6 sm:p-8 rounded-tl-[40px] rounded-br-[40px] rounded-tr-lg rounded-bl-lg shadow-2xl")

      //- Mensajes de estado / errores
      if successMessage
        div(class="mb-4 p-3 bg-emerald-500/20 border border-emerald-400/50 text-emerald-100 text-sm rounded-lg text-center font-medium")
          = successMessage
          |  You can follow the reply in#{' '}
          a(href="/inbox?filter=support", class="underline font-bold") your inbox
          | .

      if errorMessage
        div(class="mb-4 p-3 bg-red-500/20 border border-red-400/50 text-red-100 text-sm rounded-lg text-center font-medium")
          = errorMessage

      if errors && errors.length > 0
        div(class="mb-4 p-3 bg-red-500/20 border border-red-400/50 text-red-100 text-sm rounded-lg space-y-1")
          each error in errors
            p(class="text-xs") • #{error.msg}

      //- Formulario
      form(action="/help", method="POST", id="helpForm", class="space-y-4")

        //- Campos en grid (1 columna en celular, 2 en escritorio)
        div(class="grid grid-cols-1 sm:grid-cols-2 gap-4")

          //- First Name
          div(class="flex flex-col min-w-0")
            label(for="firstName", class="text-xs font-bold mb-1") First Name
            input(type="text", id="firstName", name="firstName", placeholder="enter your first name", value=formData.firstName || '', required, maxlength="50", class="w-full px-3 py-2 rounded-md bg-[#2565AE] border border-white/20 text-white placeholder:text-white/60 text-xs focus:outline-hidden focus:ring-2 focus:ring-tech")

          //- Email
          div(class="flex flex-col min-w-0")
            label(for="email", class="text-xs font-bold mb-1") Email
            input(type="email", id="email", name="email", placeholder="enter your email", value=formData.email || '', required, maxlength="255", class="w-full px-3 py-2 rounded-md bg-[#2565AE] border border-white/20 text-white placeholder:text-white/60 text-xs focus:outline-hidden focus:ring-2 focus:ring-tech")

          //- Last Name
          div(class="flex flex-col min-w-0")
            label(for="lastName", class="text-xs font-bold mb-1") Last Name
            input(type="text", id="lastName", name="lastName", placeholder="enter your last name", value=formData.lastName || '', required, maxlength="50", class="w-full px-3 py-2 rounded-md bg-[#2565AE] border border-white/20 text-white placeholder:text-white/60 text-xs focus:outline-hidden focus:ring-2 focus:ring-tech")

          //- Phone
          div(class="flex flex-col min-w-0")
            label(for="phone", class="text-xs font-bold mb-1") Phone
            input(type="tel", id="phone", name="phone", placeholder="enter your phone number", value=formData.phone || '', required, maxlength="20", class="w-full px-3 py-2 rounded-md bg-[#2565AE] border border-white/20 text-white placeholder:text-white/60 text-xs focus:outline-hidden focus:ring-2 focus:ring-tech")

        //- Campo Description
        div(class="flex flex-col mt-2")
          label(for="description", class="text-xs font-bold mb-1") Description
          textarea(id="description", name="description", rows="5", maxlength="300", placeholder="Please enter a message describing the situation, problem, or suggestion you have", required, class="w-full p-3 rounded-md bg-[#2565AE] border border-white/20 text-white placeholder:text-white/60 text-xs focus:outline-hidden focus:ring-2 focus:ring-tech resize-none")= formData.description || ''

          div(id="charCounter", class="text-right text-[11px] text-white/80 mt-1 font-mono") #{(formData.description || '').length} / 300 characters

        //- Botón enviar
        button(type="submit", class="w-full bg-tech hover:bg-[#0596e0] text-white font-extrabold py-3 rounded-lg transition duration-200 shadow-md text-sm mt-4 cursor-pointer") Send Message

block scripts
  script(src="/js/HU-011.js")
