extends layouts/app

block content
  div(class="flex flex-col gap-6", id="extendTimeContainer")
    if errorMessage
      .alert.alert-error
        i.fas.fa-exclamation-circle
        span= errorMessage

    if !sessionView
      //- Sin sesión activa
      div(class="card")
        .empty-state
          i(class="fas fa-car-side text-3xl text-muted")
          p(class="font-semibold text-ink") You have no active parking session.
          p(class="text-sm text-muted") Start one first and you can add more time here.
          a(href="/parking/start", class="btn btn-primary mt-2")
            i.fas.fa-circle-play
            span Start parking

    else
      //- Varias sesiones activas: elegir cuál extender
      if activeSessions.length > 1
        div(class="flex items-center gap-2 flex-wrap")
          span(class="text-xs font-semibold text-muted") Your active sessions:
          each s in activeSessions
            a(href='/parking/extend?session=' + s.id, class="chip" + (s.id === sessionView.id ? ' active' : ''))= (s.spaceId || s.zone) + ' · ' + s.plate

      div(class="grid grid-cols-12 gap-6 items-start")

        //- Columna izquierda: sesión activa + opciones
        div(class="card col-span-12 lg:col-span-8")
          div(class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center")

            //- Anillo de tiempo restante
            div(class="flex flex-col items-center gap-3")
              span(class="text-xs font-bold tracking-wider text-muted uppercase") Active session
              div(class="relative w-[200px] h-[200px]")
                svg(width="200", height="200", viewBox="0 0 200 200", class="-rotate-90")
                  defs
                    linearGradient(id="ringGradient", x1="0", y1="0", x2="1", y2="1")
                      stop(offset="0%", stop-color="#7C5CFF")
                      stop(offset="100%", stop-color="#06ACFF")
                  circle(cx="100", cy="100", r="84", fill="none", stroke="#EEF2F7", stroke-width="14")
                  circle(id="timeRing", cx="100", cy="100", r="84", fill="none", stroke="url(#ringGradient)", stroke-width="14", stroke-linecap="round", stroke-dasharray="527.79", stroke-dashoffset="0")
                div(class="absolute inset-0 flex flex-col items-center justify-center text-center")
                  span(class="text-xs text-muted") Time left
                  strong(id="timeLeft", class="text-3xl font-extrabold text-ink") …
                  span(id="endsAt", class="text-xs text-muted") ends —
              span(class="pill pill-info")
                i.fas.fa-car
                |  #{sessionView.spaceId || sessionView.zone} · #{sessionView.plate}

            //- Opciones para extender
            div(class="flex flex-col gap-4")
              div
                h2.card-title Extend your time
                p.card-subtitle Pay only for the extra time you need.

              if sessionView.allowsExtension
                div(id="extendOptions", class="grid grid-cols-2 gap-3")
                  each opt, i in options
                    button(type="button", class="extend-option" + (i === 0 ? ' selected' : ''), data-hours=opt.hours, data-amount=opt.amount)
                      strong(class="text-lg font-bold text-ink")= '+' + opt.hours + ' h'
                      span(class="text-xs text-muted")= opt.amountText
              else
                .alert.alert-info
                  i.fas.fa-circle-info
                  span This parking session can no longer be extended.

              .data-list
                .data-list-item
                  span.data-list-label New end time
                  span.data-list-value#newEndTime —
                .data-list-item
                  span.data-list-label Extra cost
                  span.data-list-value#extraCost= options.length ? options[0].amountText : '—'
                .data-list-item
                  span.data-list-label Total today
                  span.data-list-value#totalToday= totalTodayText

              div(id="extendError", class="alert alert-error hidden", role="alert")
                i.fas.fa-exclamation-circle
                span(id="extendErrorText")

              button(type="button", id="extendBtn", class="btn btn-primary btn-block", disabled=!sessionView.allowsExtension)
                i.fas.fa-clock
                span(class="btn-label") Extend 1 h

        //- Columna derecha: historial de hoy
        div(class="card col-span-12 lg:col-span-4")
          span(class="text-xs font-bold tracking-wider text-muted uppercase") Session history
          ul(id="historyList", class="flex flex-col gap-4 mt-4")
            each item in todayItems
              li(class="flex items-start gap-3")
                span(class="w-2.5 h-2.5 rounded-full mt-1.5 shrink-0 " + (item.type === 'parking' ? 'bg-primary' : 'bg-accent'))
                div(class="flex-1 min-w-0")
                  p(class="text-sm font-semibold text-ink")= (item.type === 'parking' ? 'Started · ' : 'Extended · ') + (item.spaceId || item.zone)
                  p(class="text-xs text-muted history-time", data-time=item.timeIso)= item.rateType === 'day' ? item.quantity + ' day' : item.quantity + ' h'
                span(class="text-sm font-bold text-ink")= item.amountText
            if todayItems.length === 0
              li(id="historyEmpty", class="text-xs text-muted") No payments today.

          div(class="alert alert-info mt-6 text-xs")
            i.fas.fa-bell
            span We'll send you an alert 10 minutes before your time ends.

      //- Datos para el JS
      div(id="sessionData", class="hidden", data-session-id=sessionView.id, data-start=sessionView.startIso, data-end=sessionView.endIso, data-space=(sessionView.spaceId || sessionView.zone), data-total-today=totalToday)

block scripts
  script(src="/js/HU-005.js")
