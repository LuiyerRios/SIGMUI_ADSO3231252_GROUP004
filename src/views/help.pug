doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title= title || 'Help & Support - SIGMUI'
    link(rel="stylesheet" href="/css/style.css")
  body(class="bg-[#E6F2F8] min-h-screen flex flex-col justify-center items-center p-4 sm:p-6 font-sans")
    
    //- Encabezado principal
    div(class="text-center max-w-xl mb-6")
      h1(class="text-3xl sm:text-4xl font-extrabold text-black tracking-tight")
        | Are you having 
        span(class="text-[#06ACFF]") any problems?
      p(class="text-black text-xs sm:text-sm mt-2 font-medium leading-relaxed px-2")
        | Send us a message describing the issue you're experiencing, and our agents will resolve it quickly. You can also send us any suggestions.

    //- Tarjeta Azul Principal (#1A5292)
    div(class="w-full max-w-xl bg-[#1A5292] text-white p-6 sm:p-8 rounded-tl-[40px] rounded-br-[40px] rounded-tr-lg rounded-bl-lg shadow-2xl")
      
      //- Mensajes de Estado / Errores
      if successMessage
        div(class="mb-4 p-3 bg-emerald-500/20 border border-emerald-400/50 text-emerald-200 text-sm rounded-lg text-center font-medium")
          = successMessage

      if errorMessage
        div(class="mb-4 p-3 bg-red-500/20 border border-red-400/50 text-red-200 text-sm rounded-lg text-center font-medium")
          = errorMessage

      if errors && errors.length > 0
        div(class="mb-4 p-3 bg-red-500/20 border border-red-400/50 text-red-200 text-sm rounded-lg space-y-1")
          each error in errors
            p(class="text-xs") • #{error.msg}

      //- Formulario
      form(action="/help" method="POST" id="helpForm" class="space-y-4")
        
        //- Campos en Grid (1 columna en móvil, 2 en Desktop)
        div(class="grid grid-cols-1 sm:grid-cols-2 gap-4")
          
          //- First Name
          div(class="flex flex-col")
            label(for="firstName" class="text-xs font-bold mb-1") First Name
            input(
              type="text" 
              id="firstName" 
              name="firstName" 
              placeholder="enter your first name" 
              value=formData.firstName || ''
              required
              class="w-full px-3 py-2 rounded-md bg-[#2565AE] border border-white/20 text-white placeholder-white/60 text-xs focus:outline-none focus:ring-2 focus:ring-[#06ACFF]"
            )

          //- Email
          div(class="flex flex-col")
            label(for="email" class="text-xs font-bold mb-1") Email
            input(
              type="email" 
              id="email" 
              name="email" 
              placeholder="enter your email" 
              value=formData.email || ''
              required
              class="w-full px-3 py-2 rounded-md bg-[#2565AE] border border-white/20 text-white placeholder-white/60 text-xs focus:outline-none focus:ring-2 focus:ring-[#06ACFF]"
            )

          //- Last Name
          div(class="flex flex-col")
            label(for="lastName" class="text-xs font-bold mb-1") Last Name
            input(
              type="text" 
              id="lastName" 
              name="lastName" 
              placeholder="enter your last name" 
              value=formData.lastName || ''
              required
              class="w-full px-3 py-2 rounded-md bg-[#2565AE] border border-white/20 text-white placeholder-white/60 text-xs focus:outline-none focus:ring-2 focus:ring-[#06ACFF]"
            )

          //- Phone
          div(class="flex flex-col")
            label(for="phone" class="text-xs font-bold mb-1") Phone
            input(
              type="tel" 
              id="phone" 
              name="phone" 
              placeholder="enter your phone number" 
              value=formData.phone || ''
              required
              class="w-full px-3 py-2 rounded-md bg-[#2565AE] border border-white/20 text-white placeholder-white/60 text-xs focus:outline-none focus:ring-2 focus:ring-[#06ACFF]"
            )

        //- Campo Description
        div(class="flex flex-col mt-2")
          label(for="description" class="text-xs font-bold mb-1") Description
          textarea(
            id="description" 
            name="description" 
            rows="5" 
            maxlength="300"
            placeholder="Please enter a message describing the situation, problem, or suggestion you have" 
            required
            class="w-full p-3 rounded-md bg-[#2565AE] border border-white/20 text-white placeholder-white/60 text-xs focus:outline-none focus:ring-2 focus:ring-[#06ACFF] resize-none"
          )= formData.description || ''
          
          div(class="text-right text-[11px] text-white/80 mt-1 font-mono" id="charCounter") 0 / 300 characters

        //- Botón Enviar (#06ACFF)
        button(
          type="submit" 
          class="w-full bg-[#06ACFF] hover:bg-[#0596e0] text-white font-extrabold py-3 rounded-lg transition duration-200 shadow-md text-sm mt-4 cursor-pointer"
        ) Send Message

    //- Botón Go Back
    div(class="w-full max-w-xl mt-4 flex justify-start")
      a(href="/" class="inline-flex items-center gap-2 text-black font-extrabold hover:text-[#06ACFF] transition-colors text-sm")
        svg(xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5")
          path(stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1")
        span Go Back

    script(src="/js/help.js")