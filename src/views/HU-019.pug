//- HU-019 (#35) · Tarifas por tipo de vehículo y reglas de cada zona (solo admin) · migración 007
extends layouts/app

block content
  div(class="flex flex-col gap-5")

    if errorMessage
      .alert.alert-error
        i.fas.fa-triangle-exclamation
        span= errorMessage

    .alert.alert-info
      i.fas.fa-circle-info
      span The price depends on the vehicle type. Changes apply only to new parking sessions; active sessions keep the rate they already paid.

    //- Tarifas por tipo de vehículo
    .card
      .card-header
        h2.card-title Rates by vehicle type
        p.card-subtitle Colombian pesos. Extensions are charged at the same hourly rate.
      div(id="rateGrid", class="grid grid-cols-1 md:grid-cols-2 2xl:grid-cols-4 gap-4 mt-4")
        each r in rates
          form.rate-form(data-type=r.type, novalidate, class="flex flex-col gap-3 p-4 rounded-2xl border border-line")
            div(class="flex items-center gap-3")
              span(class="w-9 h-9 shrink-0 rounded-xl bg-primary/10 text-primary flex items-center justify-center")
                i(class=`fas ${r.icon}`)
              strong(class="text-sm text-ink")= r.type
            div(class="grid grid-cols-2 gap-2")
              .field(class="mb-0")
                label(for=`hour${r.type}`) Per hour
                input.input(id=`hour${r.type}`, name="ratePerHour", type="number", min="1", step="1", inputmode="numeric", required, value=r.ratePerHour)
              .field(class="mb-0")
                label(for=`day${r.type}`) Per day
                input.input(id=`day${r.type}`, name="ratePerDay", type="number", min="1", step="1", inputmode="numeric", required, value=r.ratePerDay)
            p.field-error(data-role="error", hidden)
            button.btn.btn-secondary(type="submit")
              i.fas.fa-save
              span Save rate

    if zones.length === 0 && !errorMessage
      .card
        p(class="text-sm text-muted text-center py-6") No zones are configured yet.

    div(id="zoneGrid", class="grid grid-cols-1 lg:grid-cols-2 2xl:grid-cols-3 gap-5")
      each z in zones
        form.card.zone-form(data-zone=z.code, novalidate, class="flex flex-col gap-4")
          //- Encabezado de la zona
          div(class="flex items-start justify-between gap-3")
            div(class="flex items-center gap-3 min-w-0")
              span(class="w-11 h-11 shrink-0 rounded-xl bg-primary/10 text-primary font-bold text-lg flex items-center justify-center")= z.code
              div(class="min-w-0")
                h2.card-title= z.name
                p(class="text-xs text-muted truncate")= `${z.spaces} spaces · ${z.preferentialSpaces} preferential`
            span(class="pill whitespace-nowrap shrink-0 " + (z.isOpen ? 'pill-success' : 'pill-muted'), data-role="open-pill")= z.isOpen ? 'Open now' : 'Closed now'

          //- Qué vehículos acepta la zona (migración 007)
          .field(class="mb-0")
            label(for=`class${z.code}`) Vehicles allowed
            select.input(id=`class${z.code}`, name="vehicleClass")
              each label, key in zoneClassLabels
                option(value=key, selected=(key === z.vehicleClass))= label

          //- Horario de servicio
          div(class="grid grid-cols-2 gap-3")
            .field(class="mb-0")
              label(for=`opens${z.code}`) Opens at
              input.input(id=`opens${z.code}`, name="opensAt", type="time", required, value=z.opensAt)
            .field(class="mb-0")
              label(for=`closes${z.code}`) Closes at
              input.input(id=`closes${z.code}`, name="closesAt", type="time", required, value=z.closesAt)

          //- Regla de extensión
          label(class="flex items-center justify-between gap-3 p-3 rounded-control bg-surface-soft cursor-pointer")
            span(class="flex flex-col")
              span(class="text-xs font-semibold text-ink") Allow extensions
              span(class="text-[11px] text-muted") Drivers can add time before the session expires
            input(type="checkbox", name="allowsExtension", checked=z.allowsExtension, class="w-5 h-5 accent-accent cursor-pointer")

          p.field-error(data-role="error", hidden)

          //- Pie: resumen y guardar
          div(class="flex items-center justify-between gap-3 pt-3 border-t border-line flex-wrap")
            span(class="text-[11px] text-muted", data-role="summary")
              | #{z.classLabel} · #{z.scheduleText} · #{z.activeSessions} active
            button.btn.btn-primary(type="submit")
              i.fas.fa-save
              span Save zone

block scripts
  script(src="/js/HU-019.js")
