
doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Recuperar contraseña | Tech Parking
    link(rel="stylesheet" href="/css/HU-009.css")
    script(src="/js/HU-009.js" defer)

  body
    main.recovery-page
      section.brand-panel
        a.brand(href="/" aria-label="Tech Parking")
          span.brand-icon P
          span tech parking

        div.brand-message
          h1 Locked out?
            br
            | We've got you.
          p Reset your password in two steps and get back to your parking.

        p.brand-footer Park smarter. Move better. - © Team 004 - SENA ADSO 3231252

      section.form-panel
        div.recovery-card
          div.lock-icon(aria-hidden="true")
            svg(
              xmlns="http://www.w3.org/2000/svg"
              width="25"
              height="25"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            )
              rect(x="4" y="10" width="16" height="11" rx="2")
              path(d="M8 10V7a4 4 0 0 1 8 0v3")

          h2 Forgot your password?
          p.description Type the email of your account and we'll send you a link to create a new password. The link works for 1 hour.

          form#recovery-form(novalidate)
            div.email-field
              svg(
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                aria-hidden="true"
              )
                rect(x="3" y="5" width="18" height="14" rx="2")
                path(d="m3 7 9 6 9-6")

              div.input-content
                label(for="email") Email address
                input#email(
                  type="email"
                  name="email"
                  placeholder="usuario@hotmail.com"
                  autocomplete="email"
                  aria-describedby="email-error form-message"
                  required
                )

            p#email-error.field-error(role="alert" aria-live="polite")

            button#send-button(type="submit")
              span Send reset link
              span(aria-hidden="true") →

            p#form-message.form-message(role="status" aria-live="polite")

          a.back-link(href="/login")
            span(aria-hidden="true") →
            | Back to sign in
