extends layouts/admin-settings

block content
  //- Page Heading
  .page-heading
    div
      h1 Settings
      p Manage your account, security and preferences
    .heading-breadcrumb
      span Dashboard
      i.fas.fa-chevron-right
      strong Settings

  //- Information Banner
  .settings-info-banner
    .info-icon
      i.fas.fa-info-circle
    .info-content
      strong Manage your administrator account
      p Keep your profile information and security preferences up to date.

  //- Profile Information
  section.settings-card#profileSection
    .settings-card-header
      .settings-section-icon.profile-icon
        i.fas.fa-user
      .settings-section-heading
        h2 Profile Information
        p Update your personal and contact information.

    form#profileForm.settings-form
      .form-grid
        .form-group
          label(for="fullName") Full Name
          input#fullName(type="text" name="fullName" placeholder="Enter your full name" required maxlength="100" value=admin ? admin.fullName : '')
          small.field-error#fullNameError

        .form-group
          label(for="email") Email Address
          input#email(type="email" name="email" placeholder="Enter your email address" required maxlength="255" value=admin ? admin.email : '')
          small.field-error#emailError

        .form-group
          label(for="phone") Phone Number
          input#phone(type="tel" name="phone" placeholder="Enter your phone number" maxlength="20" value=admin && admin.phone ? admin.phone : '')
          small.field-error#phoneError

        .form-group.form-group-full
          label(for="primaryAddress") Primary Address
          input#primaryAddress(type="text" name="primaryAddress" placeholder="Enter your primary address" maxlength="255" value=admin && admin.primaryAddress ? admin.primaryAddress : '')
          small.field-error#addressError

      .form-actions
        button.btn-secondary#cancelProfile(type="button") Cancel
        button.btn-primary(type="submit")
          i.fas.fa-save
          span Save Changes

  //- Password and Security
  section.settings-card#securitySection
    .settings-card-header
      .settings-section-icon.security-icon
        i.fas.fa-shield-alt
      .settings-section-heading
        h2 Password & Security
        p Protect your account by keeping your password secure.

    form#passwordForm.settings-form
      .form-grid
        .form-group
          label(for="currentPassword") Current Password
          .password-input-wrapper
            input#currentPassword(type="password" name="currentPassword" placeholder="Enter current password" required)
            button.password-toggle(type="button" data-target="currentPassword" aria-label="Show password")
              i.fas.fa-eye
        small.field-error#currentPasswordError

        .form-group
          label(for="newPassword") New Password
          .password-input-wrapper
            input#newPassword(type="password" name="newPassword" placeholder="Enter new password" required)
            button.password-toggle(type="button" data-target="newPassword" aria-label="Show password")
              i.fas.fa-eye
          small.field-error#newPasswordError

        .form-group
          label(for="confirmPassword") Confirm New Password
          .password-input-wrapper
            input#confirmPassword(type="password" name="confirmPassword" placeholder="Confirm new password" required)
            button.password-toggle(type="button" data-target="confirmPassword" aria-label="Show password")
              i.fas.fa-eye
          small.field-error#confirmPasswordError

      .password-requirements
        strong Password requirements
        ul
          li At least 8 characters
          li At least one uppercase letter
          li At least one lowercase letter
          li At least one number

      .form-actions
        button.btn-secondary#cancelPassword(type="button") Cancel
        button.btn-primary(type="submit")
          i.fas.fa-lock
          span Update Password

  //- Administrative Preferences
  section.settings-card#preferencesSection
    .settings-card-header
      .settings-section-icon.preferences-icon
        i.fas.fa-sliders-h
      .settings-section-heading
        h2 Administrative Preferences
        p Customize your personal application experience.

    form#preferencesForm.settings-form
      .form-grid
        .form-group
          label(for="preferredLanguage") Language
          select#preferredLanguage(name="preferredLanguage")
            option(value="en" selected=admin && admin.preferredLanguage === 'en') English
            option(value="es" selected=admin && admin.preferredLanguage === 'es') Spanish

        .form-group
          label(for="preferredTheme") Theme
          select#preferredTheme(name="preferredTheme")
            option(value="light" selected=admin && admin.preferredTheme === 'light') Light
            option(value="dark" selected=admin && admin.preferredTheme === 'dark') Dark

      .form-actions
        button.btn-secondary#cancelPreferences(type="button") Cancel
        button.btn-primary(type="submit")
          i.fas.fa-save
          span Save Preferences

  //- Notification Preferences
  section.settings-card#notificationsSection
    .settings-card-header
      .settings-section-icon.notifications-icon
        i.fas.fa-bell
      .settings-section-heading
        h2 Notification Preferences
        p Choose which notifications you want to receive.

    form#notificationsForm.settings-form
      .notification-option
        .notification-option-info
          strong Account Activity
          p Receive notifications about important activity related to your account.
        label.switch
          input#notifyAccountActivity(type="checkbox" name="notifyAccountActivity" checked=admin ? admin.notifyAccountActivity : true)
          span.switch-slider

      .notification-divider

      .notification-option
        .notification-option-info
          strong Important System Events
          p Receive notifications about important system updates and events.
        label.switch
          input#notifySystemEvents(type="checkbox" name="notifySystemEvents" checked=admin ? admin.notifySystemEvents : true)
          span.switch-slider

      .form-actions
        button.btn-secondary#cancelNotifications(type="button") Cancel
        button.btn-primary(type="submit")
          i.fas.fa-save
          span Save Notifications

  //- Feedback Toast
  #settingsToast.toast-notification(role="status" aria-live="polite")
    i.fas.fa-check-circle
    span#toastMessage Settings updated successfully.