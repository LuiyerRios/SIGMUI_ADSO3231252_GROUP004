mixin field(id, label, icon, type, autocomplete, isRequired)
  div(class="relative")
    img(src=`/img/signup/${icon}.svg`, alt="", class="pointer-events-none absolute left-[15px] top-[17.5px] size-[17px]")
    input(
      id=id,
      name=id,
      type=type,
      placeholder=" ",
      autocomplete=autocomplete,
      required=isRequired,
      class="peer h-[52px] w-full rounded-xl border border-line bg-white pb-2 pl-[44px] pr-3 pt-5 text-[14.5px] font-medium leading-[22px] text-ink outline-none focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/20"
    )
    label(for=id, class="pointer-events-none absolute left-[44px] top-[6px] text-[11px] font-medium leading-[17px] text-brand-primary peer-[:not(:focus):placeholder-shown]:top-[15px] peer-[:not(:focus):placeholder-shown]:text-[14.5px] peer-[:not(:focus):placeholder-shown]:leading-[22px] peer-[:not(:focus):placeholder-shown]:text-muted")= label

doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title= title || 'Sign up | SIGMUI'
    link(rel="preconnect", href="https://fonts.googleapis.com")
    link(rel="preconnect", href="https://fonts.gstatic.com", crossorigin)
    link(rel="stylesheet", href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap")
    link(rel="stylesheet", href="/css/HU-002.css")
    script(src="/js/HU-002.js", defer)
  body
    div(class="flex min-h-dvh flex-col lg:flex-row")

      //- Panel azul: franja superior en celular, columna izquierda en escritorio
      aside(class="relative flex h-[224px] shrink-0 flex-col overflow-hidden bg-[linear-gradient(135deg,#1c4d87_0%,#2565ae_30%,#06acff_70%,#7c5cff_100%)] px-6 pt-7 text-white lg:h-auto lg:w-[520px] lg:px-14 lg:pt-[52px]")
        div(class="absolute -right-[70px] -top-20 size-[220px] rounded-full bg-white/20 lg:-right-[140px] lg:-top-[120px] lg:size-[380px] lg:bg-white/10")
        div(class="absolute -bottom-[70px] -left-[90px] hidden size-[280px] rounded-full bg-[#7c5cff]/40 lg:block")

        div(class="relative flex items-center gap-[10px] lg:gap-3")
          span(class="flex size-[38px] items-center justify-center rounded-[10px] border border-white/40 bg-white/20 pt-[3px] text-lg font-bold leading-[27px] lg:size-[44px] lg:rounded-xl lg:text-[22px] lg:leading-[33px]") P
          span(class="pt-[2px] text-xl font-bold leading-[30px] lg:pt-px lg:text-2xl lg:leading-[33px]")
            span(class="text-brand-tech-soft") tech
            |  parking

        div(class="relative mt-[18px] lg:mt-[283.5px]")
          h1(class="text-[32px] font-bold leading-[35px] tracking-[-0.6px] lg:text-[46px] lg:leading-[49px] lg:tracking-[-1.2px]")
            span(class="block whitespace-nowrap") Join Tech Parking
            span(class="block whitespace-nowrap") in a minute.
          p(class="mt-[18.5px] hidden max-w-[408px] text-base leading-[25.6px] text-white/90 lg:block") Register your account and your vehicles, then park in any blue zone from your phone.

        p(class="relative mt-auto hidden pb-[51.25px] pt-8 text-[12.5px] leading-[18.75px] text-white/80 lg:block") Park smarter. Move better. · © Team 004 · SENA ADSO 3231252

      main(class="relative -mt-10 flex flex-1 flex-col px-4 lg:mt-0 lg:justify-center lg:px-3")

        //- Tarjeta de registro
        div(class="relative mx-auto w-full max-w-[520px] rounded-[22px] bg-white px-[22px] pb-6 pt-[29px] shadow-[0_1px_2px_0_rgba(23,32,51,0.1)] lg:top-[0.5px] lg:bg-white/90 lg:px-10 lg:pb-9 lg:pt-[37px]")
          h2(class="text-[23px] font-bold leading-8 lg:text-[26px] lg:leading-9 lg:tracking-[-0.5px]") Create your account
          p(class="mt-[5px] text-[13.5px] leading-5 text-muted lg:mt-2 lg:text-sm lg:leading-[20.5px]") It takes less than a minute. We'll send you a link to verify your email.

          form(id="registro-form", class="mt-[18px] lg:mt-[19px]")
            div(class="grid gap-3 lg:grid-cols-2")
              +field('full_name', 'Full name', 'user', 'text', 'name', true)
              +field('phone_number', 'Phone', 'phone', 'tel', 'tel', false)

            div(class="mt-3 lg:mt-[18px]")
              +field('email_address', 'Email address', 'mail', 'email', 'email', true)

            div(class="mt-3 lg:mt-[18px]")
              +field('password', 'Password', 'lock', 'password', 'new-password', true)

            //- Requisitos de la contraseña; public/js/HU-002.js los actualiza al escribir
            div(class="mt-[14px] flex gap-[6px] lg:gap-[5.33px]")
              each _ in [1, 2, 3, 4]
                span(data-strength-bar, class="h-[6px] flex-1 rounded-[3px] bg-track")

            ul(class="mt-2 flex flex-wrap justify-between gap-x-2 whitespace-nowrap text-[11px] font-medium leading-[17px] text-muted lg:justify-start lg:gap-[15.6px] lg:text-xs lg:leading-[18px]")
              li(data-rule="length", data-label="8+ characters") ○ 8+ characters
              li(data-rule="upper", data-label="Uppercase") ○ Uppercase
              li(data-rule="number", data-label="Number") ○ Number
              li(data-rule="symbol", data-label="Symbol") ○ Symbol

            div(class="mt-[14px] lg:mt-[18px]")
              +field('confirm_password', 'Confirm password', 'lock', 'password', 'new-password', true)

            //- Aceptación de términos y política de datos
            div(class="mt-[18px] flex items-center text-[13px] leading-5 text-ink-soft")
              span(class="relative mr-[10px] size-5 shrink-0")
                input(id="terms", type="checkbox", required, class="peer absolute inset-0 size-5 cursor-pointer opacity-0")
                span(class="pointer-events-none flex size-5 items-center justify-center rounded-md border border-line bg-white peer-checked:border-brand-primary peer-checked:bg-brand-primary peer-focus-visible:ring-2 peer-focus-visible:ring-brand-primary/40 [&>img]:invisible peer-checked:[&>img]:visible")
                  img(src="/img/signup/check.svg", alt="", class="size-[14px]")
              label(for="terms", class="cursor-pointer") I accept the
              a(href="#", class="ml-1 font-semibold text-brand-primary hover:underline lg:ml-[9px]") terms
              span(class="ml-1 lg:ml-[13px]") and the
              a(href="#", class="ml-1 font-semibold text-brand-primary hover:underline lg:ml-[7px]") data policy

            div(id="mensaje-feedback", role="status", class="mt-[14px] text-[13px] font-medium leading-5 empty:hidden")

            button(
              type="submit",
              class="mt-[18px] flex h-[52px] w-full cursor-pointer items-center justify-center gap-[10px] rounded-[10px] bg-[linear-gradient(135deg,#2565ae_0%,#06acff_100%)] text-[15.5px] font-semibold leading-[21px] text-white shadow-[0_8px_20px_0_rgba(37,101,174,0.3)] transition hover:opacity-90"
            )
              | Create account
              img(src="/img/signup/arrow.svg", alt="", class="size-[18px]")

            p(class="mt-[18px] text-center text-[13px] leading-5 text-muted lg:text-[13.5px]")
              | Already have an account?
              a(href="/login", class="ml-[3.5px] font-semibold text-brand-primary hover:underline") Sign in

        //- Footer, solo en celular
        p(class="mt-auto pb-5 pt-6 text-center text-[11.5px] leading-[17.25px] text-muted lg:hidden") Park smarter. Move better. · © Team 004 · SENA ADSO 3231252
