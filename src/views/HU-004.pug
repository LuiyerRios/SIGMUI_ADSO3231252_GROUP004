doctype html
html

  head

    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")

    title My Reservations

    link(rel="stylesheet", href="/css/style.css")


  body


    .main-container


      .header


        .header-left

          img(
            src="/img/calendario.png"
            alt="Calendar"
          )

          h2 My Reservations



        .header-right(onclick="goBack()")

          img(
            src="/img/flecha.png"
            alt="Back"
          )

      .content

        .form

          input#plate(
            type="text"
            placeholder="Plate (required)"
          )

          select#zone

            option(value="") Select Zone

            option(value="A1") A1

            option(value="A2") A2

            option(value="B1") B1

          select#type

            option(value="hour") Per Hour ($2.000)

            option(value="day") Per Day ($20.000)

          input#quantity(
            type="number"
            placeholder="Hours or Days"
          )

          p

            | Total: $

            span#total 0

          button(
            onclick="calculate()"
          )

            | Calculate

          button(
            onclick="confirmReservation()"
          )

            | Confirm

        .top-bar

          h3 List of reservations

          button.btn(
            onclick="showReservations()"
          )

            | View reservation

        .table-container#reservationTable(
          style="display:none"
        )

          table

            thead

              tr

                th Nro

                th Plate

                th Location

                th Time

                th Status

            tbody#tableBody

    script(src="/js/HU-004.js")