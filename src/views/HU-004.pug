extends layouts/main

block content
  .parking-container
    h2 Start Parking Session
    p Select your space and duration to register your parking session.

    .parking-card
      form#parkingForm(on-submit="return false;")
        .form-group
          label(for="plateInput") Vehicle Plate:
          input#plateInput.form-control(type="text", placeholder="ABC123", required)

        .form-group
          label(for="zoneSelect") Space / Zone:
          select#zoneSelect.form-control(required)
            option(value="A1") A1 - Zone A
            option(value="B1") B1 - Zone B
            option(value="C1") C1 - Zone C
            option(value="D1") D1 - Zone D

        .form-group
          label(for="rateTypeSelect") Duration Type:
          select#rateTypeSelect.form-control(required)
            option(value="hour") Hourly
            option(value="day") Daily

        .form-group
          label(for="quantityInput") Quantity:
          input#quantityInput.form-control(type="number", min="1", max="12", value="1", required)

        .form-actions
          button#confirmReservationBtn.btn-primary(type="button") Pay & Start Session

      div#paymentMessage.payment-msg-box

  script(src="/js/HU-004.js")