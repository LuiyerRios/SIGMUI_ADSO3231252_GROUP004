extends layouts/app

block content
  - const activeSession = (activeSessions && activeSessions.length > 0) ? activeSessions[0] : null
  - const currentZoneCode = selectedZone ? selectedZone.code : 'A'

  .flex.flex-col.gap-6#driverHomeContainer(data-user-id=currentUser ? currentUser.id : '')
    if errorMessage
      .alert.alert-error
        i.fas.fa-exclamation-circle
        span= errorMessage

    //- 1. Tarjetas de Estadísticas Principales
    .stat-grid
      .stat-card
        .flex.items-center.gap-3.mb-2
          div(class="w-10 h-10 rounded-xl bg-success/10 text-success flex items-center justify-center shrink-0")
            i.fas.fa-location-dot
          .flex.flex-col
            span.card-label Available spaces
            strong.card-value#statFreeCount= totals ? totals.free : 0
        span.text-xs.text-muted Across #{zones ? zones.length : 0} zones right now

      .stat-card
        .flex.items-center.gap-3.mb-2
          div(class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center shrink-0")
            i.fas.fa-chart-pie
          .flex.flex-col
            span.card-label Occupancy
            strong.card-value#statOccupancyPercent #{totals ? totals.occupancyPercent : 0}%
        span.text-xs.text-muted#statOccupancyText #{totals ? totals.occupied : 0} of #{totals ? totals.total : 0} spaces in use

      .stat-card
        .flex.items-center.gap-3.mb-2
          div(class="w-10 h-10 rounded-xl bg-accent/10 text-accent flex items-center justify-center shrink-0")
            i.fas.fa-car
          .flex.flex-col
            span.card-label My active parking
            strong.card-value#statActiveSessionText= activeSession ? `${activeSession.spaceId} · ${activeSession.plate}` : '—' span.text-xs.text-muted#statActiveSessionSub= activeSession ? `Zone ${activeSession.zone}` : 'No active session'

      .stat-card
        .flex.items-center.gap-3.mb-2
          div(class="w-10 h-10 rounded-xl bg-warning/10 text-warning flex items-center justify-center shrink-0")
            i.fas.fa-clock
          .flex.flex-col
            span.card-label Time remaining
            strong.card-value#statTimeRemaining= activeSession ? 'Calculating...' : '—'
        span.text-xs.text-muted#statTimeRemainingSub(data-end-time=activeSession ? new Date(activeSession.endTime).toISOString() : '')= activeSession ? 'Active session' : '—'

    //- 2. Contenido Principal: Mapa de Zonas y Panel de Detalle
    .grid.grid-cols-12.gap-6.items-start
      //- Columna Izquierda: Mapa de Espacios
      div(class="card col-span-12 lg:col-span-8")
        .card-header.flex.items-center.justify-between.flex-wrap.gap-4
          div
            h2.card-title Blue-zone map
            p.card-subtitle Pick a green space to start parking

          .flex.items-center.gap-2.text-xs.text-muted
            i.fas.fa-rotate
            span Auto-refresh every 30 s

        //- Chips de Selección de Zonas
        .flex.items-center.gap-2.flex-wrap.mb-6#zoneChipsContainer
          if zones
            each z in zones
              a.chip(
                href=`/