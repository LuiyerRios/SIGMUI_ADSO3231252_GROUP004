mixin heroFeature(icon, text)
  li(class="flex items-center gap-[14px]")
    span(class="flex size-9 shrink-0 items-center justify-center rounded-[10px] bg-white/20")
      img(src=`/img/login/${icon}.svg`, alt="", class="size-[18px]")
    span(class="pt-[3px] text-[15px] font-medium leading-[23px] text-white")= text

mixin mobileFeature(icon, text)
  li(class="flex items-center gap-3")
    span(class="flex size-[30px] shrink-0 items-center justify-center rounded-[9px] bg-brand-soft")
      img(src=`/img/login/${icon}.svg`, alt="", class="size-4")
    span(class="text-[13px] font-medium leading-5 text-ink-soft")= text

doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Login | SIGMUI
    link(rel="preconnect", href="https://fonts.googleapis.com")
    link(rel="preconnect", href="https://fonts.gstatic.com", crossorigin)
    link(rel="stylesheet", href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap")
    link(rel="stylesheet", href="/css/HU-001.css")
    script(src="/js/HU-001.js", defer)
  body
    div(class="flex min-h-dvh flex-col lg:flex-row")

      //- Panel azul: franja superior en celular, columna izquierda en escritorio
      aside(class="relative flex h-[252px] shrink-0 flex-col overflow-hidden bg-[linear-gradient(135deg,#1c4d87_0%,#2565ae_30%,#06acff_70%,#7c5cff_100%)] px-6 pt-7 text-white lg:h-auto lg:w-[calc(100%*813/1440)] lg:px-16 lg:pt-14")
        div(class="absolute -right-[70px] -top-20 size-[220px] rounded-full bg-white/20 lg:-right-[120px] lg:-top-[140px] lg:size-[420px] lg:bg-white/10")
        div(class="absolute -bottom-20 -left-[100px] hidden size-[300px] rounded-full bg-[#7c5cff]/40 lg:block")

        div(class="relative flex items-center gap-[10px] lg:gap-3")
          span(class="flex size-[38px] items-center justify-center rounded-[10px] border border-white/40 bg-white/20 pt-[3px] text-lg font-bold leading-[27px] lg:size-[46px] lg:rounded-xl lg:text-[22px] lg:leading-[33px]") P
          p(class="pt-[2px] text-xl font-bold leading-[30px] lg:pt-px lg:text-2xl lg:leading-[33px] lg:tracking-[-0.3px]")
            span(class="text-brand-tech-soft") tech
            |  parking

        div(class="relative mt-[18px] lg:mt-[77px]")
          p(class="inline-flex h-[26px] items-center gap-[7px] rounded-full bg-white/20 px-3 text-xs font-medium leading-[18px] lg:h-[34px] lg:gap-2 lg:border lg:border-white/30 lg:px-[14px] lg:text-[13px] lg:leading-5")
            span(class="size-[7px] rounded-full bg-[#4ade80] lg:size-2")
            | Smart blue-zone parking

          h1(class="mt-2 text-[32px] font-bold leading-[35px] tracking-[-0.6px] lg:mt-[21.5px] lg:text-[60px] lg:leading-[63px] lg:tracking-[-1.5px]")
            span(class="block whitespace-nowrap") Park smarter.
            span(class="block whitespace-nowrap") Move better.

          p(class="mt-[23.5px] hidden max-w-[523px] text-[17px] leading-[27.2px] text-white/90 lg:block") Find a space, pay from your phone and keep your time under control — all in one place.

          ul(class="mt-[26.6px] hidden flex-col gap-[14px] lg:flex")
            +heroFeature('pin', 'Find available blue zones')
            +heroFeature('phone', 'Pay and extend from your phone')
            +heroFeature('bell', 'Avoid fines with real-time alerts')

        p(class="relative mt-auto hidden pb-[55.25px] pt-8 text-[12.5px] leading-[18.75px] text-white/80 lg:block") © Team 004 · SENA ADSO 3231252

      main(class="relative -mt-10 flex flex-1 flex-col px-4 lg:mt-0 lg:justify-center lg:px-3")

        //- Tarjeta de inicio de sesión
        div(class="relative mx-auto w-full max-w-[440px] rounded-[22px] bg-white px-[22px] pb-6 pt-[29px] shadow-[0_1px_2px_0_rgba(23,32,51,0.1)] lg:left-[0.5px] lg:top-[0.5px] lg:border lg:border-white/90 lg:bg-white/90 lg:px-10 lg:pb-[31px] lg:pt-[41px]")
          h2(class="text-[23px] font-bold leading-8 lg:text-[28px] lg:leading-[39px] lg:tracking-[-0.5px]") Welcome back
          p(class="mt-[5px] text-[13.5px] leading-5 text-muted lg:mt-2 lg:text-[14.5px] lg:leading-[22px]") Sign in to manage your parking.

          //- Mensaje de error dinámico
          if error
            div(role="alert", class="mt-[14px] rounded-xl border border-[#fecaca] bg-[#fef2f2] px-[14px] py-[10px] text-[13px] font-medium leading-5 text-[#b42318] lg:mt-4")
              p= error

          //- Reenvío de verificación de correo (HU-012)
          if showResend
            form(action="/verify-email/resend", method="POST", class="mt-3")
              input(type="hidden", name="email", value=unverifiedEmail)
              button(
                type="submit",
                class="h-[50px] w-full cursor-pointer rounded-[14px] border border-line-strong text-[14.5px] font-semibold leading-[22px] text-brand-primary transition hover:bg-brand-soft/50"
              ) Resend verification email

          form(action="/login", method="POST", id="loginForm", class="mt-[18px] lg:mt-[21px]")
            //- Email Input
            div(class="relative")
              label(for="email", class="sr-only") Email address
              img(src="/img/login/mail.svg", alt="", class="pointer-events-none absolute left-4 top-[19px] size-[18px]")
              input(
                type="email",
                id="email",
                name="email",
                value=email || '',
                placeholder="Email address",
                autocomplete="email",
                required,
                class="h-14 w-full rounded-xl border border-line bg-white pl-[45px] pr-4 pt-[5px] text-[15px] font-medium text-ink outline-none placeholder:text-muted placeholder:opacity-100 focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/20"
              )

            //- Password Input
            div(class="relative mt-[14px] lg:mt-4")
              label(for="password", class="sr-only") Password
              img(src="/img/login/lock.svg", alt="", class="pointer-events-none absolute left-4 top-[19px] size-[18px]")
              input(
                type="password",
                id="password",
                name="password",
                placeholder="Password",
                autocomplete="current-password",
                required,
                class="h-14 w-full rounded-xl border border-line bg-white pl-[45px] pr-[50px] pt-[5px] text-[15px] font-medium text-ink outline-none placeholder:text-muted placeholder:opacity-100 focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/20"
              )
              button(
                type="button",
                id="togglePassword",
                aria-label="Show password",
                aria-pressed="false",
                class="absolute right-[11px] top-[11px] flex size-[34px] cursor-pointer items-center justify-center rounded-lg outline-none focus-visible:ring-2 focus-visible:ring-brand-primary/40 aria-pressed:opacity-50"
              )
                img(src="/img/login/eye.svg", alt="", class="size-[18px]")

            //- Link Olvidé contraseña
            div(class="mt-[14px] flex justify-end lg:mt-3")
              a(href="/forgot-password", class="text-[13px] font-medium leading-5 text-brand-primary hover:underline lg:text-[13.5px]") Forgot your password?

            //- Botones
            button(
              type="submit",
              class="mt-[14px] flex h-[52px] w-full cursor-pointer items-center justify-center gap-[10px] rounded-[14px] bg-[linear-gradient(135deg,#2565ae_0%,#06acff_100%)] text-base font-semibold leading-6 text-white shadow-[0_8px_20px_0_rgba(37,101,174,0.3)] transition hover:opacity-90 lg:mt-4 lg:h-[54px] lg:shadow-none"
            )
              | Sign in
              img(src="/img/login/arrow.svg", alt="", class="size-[18px]")

            div(class="mt-[22px] hidden items-center gap-3 lg:flex")
              span(class="h-px flex-1 bg-line")
              span(class="text-[13px] leading-5 text-muted") New to Tech Parking?
              span(class="h-px flex-1 bg-line")

            a(
              href="/signup",
              class="mt-[18px] flex h-[50px] items-center justify-center rounded-[14px] border border-line-strong text-[14.5px] font-semibold leading-[22px] text-brand-primary transition hover:bg-brand-soft/50 lg:mt-[22px] lg:h-[52px] lg:text-[15px]"
            ) Create an account

            p(class="mt-[22px] hidden items-center justify-center gap-2 text-[12.5px] leading-[19px] text-muted lg:flex")
              img(src="/img/login/shield.svg", alt="", class="size-[14px]")
              | Secure session · Passwords are encrypted

        //- Beneficios y footer, solo en celular
        div(class="mx-auto mt-auto w-full max-w-[440px] pb-[19.75px] pt-8 lg:hidden")
          ul(class="flex flex-col gap-[10px]")
            +mobileFeature('pin-blue', 'Find available blue zones')
            +mobileFeature('phone-blue', 'Pay and extend from your phone')
          p(class="mt-4 text-center text-[11.5px] leading-[17.25px] text-muted") © Team 004 · SENA ADSO 3231252
