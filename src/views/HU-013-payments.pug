//- HU-013 · My payments: pagos del conductor en sesión (parqueos y extensiones) con acceso al recibo
extends layouts/app

block content
  div(class="flex flex-col gap-6")
    if errorMessage
      .alert.alert-error
        i.fas.fa-exclamation-circle
        span= errorMessage

    .stat-grid
      .stat-card
        span.card-label Spent this month
        strong.card-value.primary= stats.monthTotal
      .stat-card
        span.card-label Parking payments
        strong.card-value= stats.parkingCount
      .stat-card
        span.card-label Extensions
        strong.card-value= stats.extensionCount
      .stat-card
        span.card-label Active now
        strong.card-value= stats.activeCount

    .card(class="p-0 overflow-hidden")
      div(class="flex items-center justify-between gap-3 flex-wrap p-5 border-b border-line")
        div
          h2.card-title Payment history
          p.card-subtitle Simulated payments · no real money was moved
        a(href="/parking/start", class="btn btn-primary")
          i.fas.fa-circle-play
          span Start parking

      //- Filtros por fecha y placa (GET normal, funciona sin JS)
      form(method="GET", action="/payments", id="paymentFilters", class="flex items-end gap-3 flex-wrap p-5 border-b border-line bg-surface-soft")
        div(class="flex flex-col min-w-0")
          label(for="from", class="text-[11px] font-semibold text-muted mb-1") From
          input.input(type="date", id="from", name="from", value=filters.from, class="w-[160px]")
        div(class="flex flex-col min-w-0")
          label(for="to", class="text-[11px] font-semibold text-muted mb-1") To
          input.input(type="date", id="to", name="to", value=filters.to, class="w-[160px]")
        div(class="flex flex-col min-w-0")
          label(for="plateFilter", class="text-[11px] font-semibold text-muted mb-1") Plate
          select.input(id="plateFilter", name="plate", class="w-[160px]")
            option(value="") All my plates
            each pl in plates
              option(value=pl, selected=(pl === filters.plate))= pl
        div(class="flex items-center gap-2")
          button.btn.btn-primary(type="submit")
            i.fas.fa-filter
            span Apply
          a.btn.btn-secondary(href="/payments") Clear
        if period
          div(class="ml-auto text-right")
            span(class="block text-[11px] font-semibold text-muted uppercase tracking-wider") Total paid in this period
            strong(id="periodTotal", class="text-xl font-extrabold text-primary")= period.totalText
            span(class="block text-[11px] text-muted") #{period.count} payment#{period.count === 1 ? '' : 's'}

      if payments.length === 0
        .empty-state
          i.far.fa-folder-open
          p= (filters.plate || stats.parkingCount > 0) ? 'No payments match the selected filters.' : 'You have no payments yet.'
      else
        .table-responsive
          table.table
            thead
              tr
                th DATE
                th RECEIPT
                th PLATE
                th ZONE · SPACE
                th TYPE
                th AMOUNT
                th
            tbody
              each p in payments
                tr
                  td.js-local-time(data-label="Date", data-time=p.paidAtIso) —
                  td.font-bold(data-label="Receipt")= p.receiptNumber
                  td.font-bold(data-label="Plate")= p.plate
                  td(data-label="Zone · space")
                    span.pill.pill-muted= p.place
                  td(data-label="Type")
                    if p.type === 'parking'
                      span.pill.pill-info Parking
                    else
                      span.pill.pill-accent Extension
                  td.font-bold(data-label="Amount")= p.amountText
                  td(data-label="")
                    div(class="flex items-center gap-2")
                      a(href=`/payments/${p.sessionId}/receipt`, class="btn btn-ghost whitespace-nowrap") View receipt
                      a(href=`/parking/receipt/${p.sessionReceipt}`, data-receipt-pdf="", class="btn btn-ghost", title="Download receipt (PDF)", aria-label=`Download receipt ${p.sessionReceipt} as PDF`)
                        i.fas.fa-file-pdf
                        span PDF

block scripts
  script(src="/js/HU-013.js")
