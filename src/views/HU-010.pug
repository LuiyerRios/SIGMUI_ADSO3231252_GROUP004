extends layouts/main2

block content
  .app
    aside.sidebar
      .logo
        .logo-icon P
        h1 Tech Parking

      nav.menu
        a.active(href="#") Parking Zones
        a.logout-button(href="/admin/dashboard") Dashboard
        a(href="/admin/help-reports") Help reports
        a(href="#") Manage Users
        a(href="#") Payment History
        a(href="#") Settings
        a.logout-button(href="/logout") Exit

      .legend
        h3 Legend
        .legend-item
          span.legend-color.available
          | Available
        .legend-item
          span.legend-color.occupied
          | Occupied
        .legend-item
          span.legend-color.selected
          | Selected

    main.main-content
      header.topbar
        .welcome
          h2 Parking Dashboard
        .top-buttons
          button Occupancy
          button Today's Bookings
          button Available
          button#themeToggle 🌙 Dark Mode

      section.statistics
        .stat-card
          .stat-icon.blue 🚗
          .stat-data
            strong#occupancy 0%
            span Occupancy
        .stat-card
          .stat-icon.green P
          .stat-data
            strong#availableCount 0
            span Available Spaces
        .stat-card
          .stat-icon.yellow 📅
          .stat-data
            strong#bookingCount 0
            span Today's Bookings
        .stat-card
          .stat-icon.purple $
          .stat-data
            strong $2,000
            span Today's Revenue

      section.dashboard-grid
        .parking-area
          .parking-header
            h3 Parking Map
            .map-controls
              label Spaces per Zone:
              input#spacesPerZone(type="number" value="10" min="1" max="50")
              label Zones:
              select#zonesList
                option(value="A,B,C,D") 4 Zones (A, B, C, D)
                option(value="A,B") 2 Zones (A, B)
                option(value="A,B,C,D,E,F") 6 Zones (A, B, C, D, E, F)
              button#resizeBtn.btn-secondary(type="button") Resize Map

          .map-note Click a space on the map to view details or update status

          .parking-map#parkingMap

        aside.details-panel
          .details-header
            h3 Selected Space
            button.close-button(type="button") ×

          .selected-badge#spaceName None

          .info-list
            .info-item
              span Status
              strong#spaceStatus.badge-status ---
            .info-item
              span Vehicle
              strong#vehicleNumber ---
            .info-item
              span Owner
              strong#ownerName ---
            .info-item
              span Entry Time
              strong#entryTime ---
            .info-item
              span Description
              strong#description ---
            .info-item
              span Zone
              strong#zoneName ---

          .change-status-box
            h4 Change Status
            .status-toggle-group
              button.btn-status.btn-status-available.available-button(type="button") Available
              button.btn-status.btn-status-occupied.occupied-button(type="button") Occupied

            button.confirm-button#confirmChanges(type="button") Confirm Changes

            p.message#message

  script(src="/js/HU-010.js")