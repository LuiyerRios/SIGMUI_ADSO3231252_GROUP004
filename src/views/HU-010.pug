extends layouts/app

block content
  - const currentZoneCode = selectedZoneCode || (config && config.zones.length > 0 ? config.zones[0] : 'A')

  .flex.flex-col.gap-6#adminHomeContainer
    if errorMessage
      .alert.alert-error
        i.fas.fa-exclamation-circle
        span= errorMessage

    //- 1. Tarjetas de Estadísticas Principales
    .stat-grid
      .stat-card
        .flex.items-center.gap-3.mb-2
          div(class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center shrink-0")
            i.fas.fa-chart-pie
          .flex.flex-col
            span.card-label Occupancy
            strong.card-value#statOccupancyPercent #{stats ? stats.occupancyPercent : 0}%
        span.text-xs.text-muted#statOccupancySub #{stats ? stats.occupied : 0} of #{stats ? stats.total : 0} spaces in use

      .stat-card
        .flex.items-center.gap-3.mb-2
          div(class="w-10 h-10 rounded-xl bg-success/10 text-success flex items-center justify-center shrink-0")
            i.fas.fa-location-dot
          .flex.flex-col
            span.card-label Available spaces
            strong.card-value#statFreeCount= stats ? stats.free : 0
        span.text-xs.text-muted#statFreeSub Across #{stats ? stats.zonesCount : 0} zones

      .stat-card
        .flex.items-center.gap-3.mb-2
          div(class="w-10 h-10 rounded-xl bg-accent/10 text-accent flex items-center justify-center shrink-0")
            i.fas.fa-calendar-check
          .flex.flex-col
            span.card-label Today's bookings
            strong.card-value#statTodayBookings= stats ? stats.todayBookings : 0
        span.text-xs.text-muted Active & paid sessions today

      .stat-card
        .flex.items-center.gap-3.mb-2
          div(class="w-10 h-10 rounded-xl bg-warning/10 text-warning flex items-center justify-center shrink-0")
            i.fas.fa-dollar-sign
          .flex.flex-col
            span.card-label Today's revenue
            strong.card-value#statTodayRevenue= formattedRevenue || '$0 COP'
        span.text-xs.text-muted Sessions & extensions today

    //- Alerta de Confirmación de Redimensionamiento
    .alert.alert-info.hidden#resizeConfirmAlert
      .flex.items-center.justify-between.w-full.flex-wrap.gap-3
        .flex.items-center.gap-2
          i.fas.fa-triangle-exclamation.text-warning
          span Dynamic map resize will reset space statuses. Confirm changes?
        .flex.items-center.gap-2
          button.btn.btn-primary.py-1.5.px-3.text-xs#confirmResizeBtn(type="button") Confirm resize
          button.btn.btn-ghost.py-1.5.px-3.text-xs#cancelResizeBtn(type="button") Cancel

    //- 2. Contenido Principal: Mapa de Parqueo y Panel Lateral
    .grid.grid-cols-12.gap-6.items-start
      //- Columna Izquierda: Mapa de Parqueo
      div(class="card col-span-12 lg:col-span-8")
        .card-header.flex.items-center.justify-between.flex-wrap.gap-4
          div
            h2.card-title Parking map
            p.card-subtitle Click a space to see details or change its status

          //- Formulario Inline de Redimensionamiento
          form#resizeMapForm(class="flex items-center gap-3 flex-wrap")
            .flex.items-center.gap-1.5
              label.text-xs.text-muted(for="inputSpacesPerZone") Spaces/zone
              input.input.w-16.py-1.px-2.text-xs#inputSpacesPerZone(
                type="number", 
                min="1", 
                max="50", 
                value=config ? config.spacesPerZone : 32
              )

            .flex.items-center.gap-1.5
              label.text-xs.text-muted(for="selectZonesRange") Zones
              select.select.w-28.py-1.px-2.text-xs#selectZonesRange
                - const currentZonesStr = config && config.zones ? config.zones.join(',') : 'A,B,C,D'
                option(value="A,B", selected=currentZonesStr === 'A,B') 2 (A–B)
                option(value="A,B,C,D", selected=currentZonesStr === 'A,B,C,D') 4 (A–D)
                option(value="A,B,C,D,E,F", selected=currentZonesStr === 'A,B,C,D,E,F') 6 (A–F)

            button.btn.btn-secondary.py-1.5.px-3.text-xs#triggerResizeBtn(type="button")
              i.fas.fa-expand.text-xs
              span Resize map

        //- Chips de Zonas
        .flex.items-center.gap-2.flex-wrap.mb-6#adminZoneChips
          if config && config.zones
            each zCode in config.zones
              - const freeInZone = spaces ? spaces.filter(s => s.zone === zCode && !s.occupied).length : 0
              button.chip(
                type="button",
                data-zone=zCode,
                class=(zCode === currentZoneCode ? 'active' : '')
              ) Zone #{zCode} · #{freeInZone} free

        //- Grid de Espacios
        div(class="grid grid-cols-4 sm:grid-cols-8 gap-3 mb-6")#adminSpacesGrid(data-current-zone=currentZoneCode)
          if spaces
            each space in spaces.filter(s => s.zone === currentZoneCode)
              button.space-grid-item(
                type="button",
                data-space-id=space.id,
                data-occupied=space.occupied ? 'true' : 'false',
                data-source=space.source || '',
                data-plate=space.plate || '',
                data-owner=space.owner || '',
                data-start-time=space.startTime || '',
                data-end-time=space.endTime || '',
                data-receipt-number=space.receiptNumber || '',
                class=space.occupied ? 'occupied' : 'available'
              )
                span.space-dot
                span.space-code= space.id

        //- Leyenda e Indicador en Vivo
        .flex.items-center.justify-between.pt-4.border-t.border-line.text-xs.text-muted.flex-wrap.gap-4
          .flex.items-center.gap-6
            .flex.items-center.gap-2
              span.w-3.h-3.rounded-full.bg-green-500
              span Available
            .flex.items-center.gap-2
              span.w-3.h-3.rounded-full.bg-red-500
              span Occupied
            .flex.items-center.gap-2
              span.w-3.h-3.rounded-full.border-2.border-accent.bg-purple-100
              span Selected

          .flex.items-center.gap-1.5
            span.w-2.h-2.rounded-full.bg-success
            span Live · updated just now

      //- Columna Derecha: Panel de Control del Espacio Seleccionado
      div(class="card col-span-12 lg:col-span-4")#adminSpacePanel
        .card-header
          span.text-xs.font-bold.tracking-wider.text-muted.uppercase SELECTED SPACE

        .flex.items-center.gap-4.mb-6
          div(class="w-14 h-14 rounded-2xl bg-gradient-to-br from-tech to-accent text-white flex items-center justify-center font-extrabold text-xl shadow-md")#adminPanelBadge
            span#adminPanelSpaceCode —
          div
            h3.text-lg.font-bold.text-ink#adminPanelSpaceTitle Select a space
            span.pill.pill-muted#adminPanelSpaceStatus Select on map

        .data-list.mb-6
          .data-list-item
            span.data-list-label Zone
            span.data-list-value#panelValZone —
          .data-list-item
            span.data-list-label Vehicle
            span.data-list-value#panelValVehicle —
          .data-list-item
            span.data-list-label Owner
            span.data-list-value#panelValOwner —
          .data-list-item
            span.data-list-label Entry time
            span.data-list-value#panelValEntryTime —
          .data-list-item
            span.data-list-label Time left
            span.data-list-value#panelValTimeLeft —

        //- Acciones de Cambio Manual de Estado
        .flex.flex-col.gap-3.pt-4.border-t.border-line
          span.text-xs.font-semibold.text-ink Change status
          .grid.grid-cols-2.gap-3
            button.btn.btn-secondary.w-full#btnSetAvailable(type="button", disabled=true) Available
            button.btn.btn-secondary.w-full#btnSetOccupied(type="button", disabled=true) Occupied

        p.text-\[11px\].text-muted.mt-3.hidden#sessionOccupiedNote Occupied by a paid session · cannot toggle manually.

block scripts
  script(src="/js/HU-010.js")