doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Tech Parking - Admin Dashboard
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css")
    link(rel="stylesheet", href="HU-010.css")
  body
    #app.app-container

      //- ==================== VISTA DE LOGIN ====================
      section#login-view.view.active-view
        .login-card
          .login-header
            .brand-logo
              span.logo-icon P
              span.logo-text tech parking
            h2 Iniciar Sesión
            p Ingrese las credenciales para acceder al sistema
          
          form#login-form.login-form(on-submit="return false;")
            .form-group
              label(for="username") Usuario
              input#username(type="text", value="admin", placeholder="Ingrese su usuario")
            .form-group
              label(for="password") Contraseña
              input#password(type="password", value="123456", placeholder="Ingrese su contraseña")
            .form-group
              label(for="role-select") Rol de Acceso
              select#role-select
                option(value="admin", selected) Administrador (Admin SIGMUI)
                option(value="operator") Operador Standard
            
            button.btn-primary#btn-login(type="button") Ingresar al Dashboard

      //- ==================== VISTA DASHBOARD ADMIN ====================
      section#admin-view.view
        //- BARRA LATERAL (SIDEBAR)
        aside.sidebar
          .sidebar-header
            .brand-logo
              span.logo-icon P
              span.logo-text tech parking
            button.sidebar-toggle
              i.fa-solid.fa-angles-left

          nav.sidebar-nav
            p.menu-title MENU
            ul.nav-list
              li.nav-item.active
                a(href="#")
                  i.fa-solid.fa-border-all
                  span Parking zones
              li.nav-item
                a(href="#")
                  i.fa-solid.fa-chart-line
                  span Dashboard
              li.nav-item.disabled
                a(href="#")
                  i.fa-solid.fa-user-group
                  span Manage users
                  span.badge SOON
              li.nav-item.disabled
                a(href="#")
                  i.fa-solid.fa-credit-card
                  span Payment history
                  span.badge SOON
              li.nav-item.disabled
                a(href="#")
                  i.fa-solid.fa-gear
                  span Settings
                  span.badge SOON

          .sidebar-footer
            .user-profile
              .avatar AS
              .user-info
                p.user-name Admin SIGMUI
                p.user-role Administrator
            button#btn-logout.btn-logout
              i.fa-solid.fa-right-from-bracket
              span Logout

        //- CONTENIDO PRINCIPAL
        main.main-content
          header.top-header
            .page-title
              h1 Parking zones
              p.subtitle Live occupancy of the blue zones · Tuesday, Oct 20
            .header-actions
              .search-box
                i.fa-solid.fa-magnifying-glass
                input#search-input(type="text", placeholder="Search space or plate...")
              .header-icons
                button.icon-btn: i.fa-solid.fa-moon
                button.icon-btn: i.fa-solid.fa-envelope
                button.icon-btn: i.fa-solid.fa-bell
              .user-greeting
                p Hello, #[strong Admin]

          //- TARJETAS DE MÉTRICAS (KPIs)
          .stats-grid
            .stat-card
              .stat-icon.blue: i.fa-solid.fa-gauge-high
              .stat-data
                span.stat-label Occupancy
                h2#kpi-occupancy 23%
                p.stat-sub#kpi-occupancy-sub 30 of 128 spaces in use
            .stat-card
              .stat-icon.green: i.fa-solid.fa-location-dot
              .stat-data
                span.stat-label Available spaces
                h2#kpi-available 98
                p.stat-sub Across 4 zones
            .stat-card
              .stat-icon.sky: i.fa-solid.fa-calendar-days
              .stat-data
                span.stat-label Today's bookings
                h2 39
                p.stat-sub.up ▲ 12% vs. yesterday
            .stat-card
              .stat-icon.purple: i.fa-solid.fa-dollar-sign
              .stat-data
                span.stat-label Today's revenue
                h2 $2.000
                p.stat-sub Demo value · from parking sessions

          //- SECCIÓN PRINCIPAL DE MAPA Y DETALLES
          .dashboard-body
            //- MAPA DE PARQUEADEROS
            .map-card
              .map-header
                .map-title-area
                  h3 Parking map
                  p Click a space to see details or change its status
                .map-meta
                  span.meta-badge Spaces/zone #[strong 32]
                  span.meta-badge Zones #[strong 4 (A–D)]
                  button.btn-resize
                    i.fa-solid.fa-expand
                    span Resize map

              .zone-tabs
                button.zone-tab.active Zone A - 25 free
                button.zone-tab Zone B - 25 free
                button.zone-tab Zone C - 24 free
                button.zone-tab Zone D - 24 free

              .spaces-grid#spaces-grid
                //- Generado dinámicamente por JavaScript

              .map-legend
                span.legend-item
                  span.dot.green
                  | Available
                span.legend-item
                  span.dot.red
                  | Occupied
                span.legend-item
                  span.dot.purple
                  | Selected
                span.legend-live
                  span.live-dot
                  | Live - updated just now

            //- PANEL LATERAL DERECHO (ESPACIO SELECCIONADO)
            aside.detail-card
              p.panel-title SELECTED SPACE
              .selected-badge-box
                .space-badge#selected-badge A7
                .space-meta-info
                  h4#selected-title Space A7
                  span.status-pill.occupied#selected-status-pill Occupied
              
              .info-list
                .info-row
                  span.info-label Zone
                  span.info-value#info-zone Zone A
                .info-row
                  span.info-label Vehicle
                  span.info-value#info-vehicle TYU-029
                .info-row
                  span.info-label Owner
                  span.info-value#info-owner Mateo Díaz
                .info-row
                  span.info-label Entry time
                  span.info-value#info-time 09:49
                .info-row
                  span.info-label Time left
                  span.info-value#info-timeleft 1h 17m

              .status-actions
                p.actions-title Change status
                .btn-group
                  button.btn-status#btn-available(onclick="updateSpaceStatus('available')") Available
                  button.btn-status.active-occupied#btn-occupied(onclick="updateSpaceStatus('occupied')") Occupied

    script(src="HU-010.js")