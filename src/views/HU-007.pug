//- HU-007 · Multa digital (diseño del equipo, conectado a POST /api/fines). Se llega desde el resultado de HU-006.
extends layouts/app

block styles
  link(rel="stylesheet", href="/css/HU-007.css")

block content
  .hu007
    main.content
      if error
        .alert.alert-error(class="mb-4")
          i.fas.fa-exclamation-circle
          span= error

      if !info
        //- Sin placa: el agente primero verifica una placa vencida
        .section
          label(for="plate") Plate of the expired vehicle
          form(action="/agent/fines/new", method="GET")
            input#plate(type="text", name="plate", maxlength="7", placeholder="ABC123", value=plate || '', autocomplete="off", required)
            button.button(type="submit", style="margin-top:12px") Load vehicle
          p.note Fines are only issued to vehicles whose parking session expired. You can also start from Verify plate.

      else if info.status !== 'expired' || info.fine
        //- Estado que no permite multa
        .section
          .status
            if info.status === 'active'
              | ✅ STATUS: ACTIVE
              small(style="color:#0b9e50") The parking session of #{info.plate} is active until #{info.expiredAt}. A fine cannot be issued.
            else if info.fine
              | 🧾 FINE ALREADY ISSUED
              small This session of #{info.plate} already has the fine #{info.fine.number} (#{info.fine.issuedAt}).
            else
              | ❔ STATUS: NOT REGISTERED
              small The plate #{info.plate} has no parking payments. A fine cannot be issued.
        a.button(href=`/agent/verify?plate=${info.plate}`, style="display:block;text-decoration:none;text-align:center") Back to verify plate

      else
        form#fineForm(data-plate=info.plate, novalidate)
          .section
            .status
              | ⚠️ STATUS: EXPIRED
              small The vehicle exceeded the time limit

          .section
            .plate
              h4= info.plate
            .info
              span.label Date:
              span.value= info.date
            .info
              span.label Location:
              span.value Zone #{info.zone} · #{info.space}
            .info
              span.label Expired:
              span.value(style="color:red;") #{info.expiredAt} (#{info.expiredAgo} ago)

          .section
            label(for="location") Current location
            input#location(type="text", name="location", maxlength="150", value=`Zone ${info.zone} · ${info.space}`, required)

          .section
            label(for="comments") Comments (optional)
            textarea#comments(name="comments", maxlength="300", placeholder="Ex: The ticket is not visible")

          .fine
            | Amount of the fine
            p#fineAmount= fineAmount

          .ticked-id
            | Ticket #:
            span#ticketNumber  Generated when you issue the fine

          p#fineError.note(role="alert", style="color:#e33e45")

          button.button#issueBtn(type="submit") Generate Ticket # Auto

          .note
            | ✅ The fine is saved in the system history with date, time, location and agent.

          div#afterFine(hidden, style="margin-top:12px")
            a.button(href="/agent/verify", style="display:block;text-decoration:none;text-align:center") Verify another plate

block scripts
  script(src="/js/HU-007.js")
