//- src/views/layouts/main.pug
doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title= title || "SIGMUI - Control de Parqueadero"
    script(src="https://cdn.tailwindcss.com")
    link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css")
  body(class="bg-gray-100 flex h-screen overflow-hidden font-sans")

    //- Sidebar Azul Lateral
    aside(class="w-64 bg-[#2565ae] text-white flex flex-col justify-between p-4 shadow-lg flex-shrink-0")
      div
        div(class="flex items-center space-x-3 mb-8")
          i(class="fas font-bold text-2xl fa-bars cursor-pointer")
        
        nav(class="space-y-4 font-medium")
          a(href="#" class="flex items-center space-x-3 text-white font-semibold hover:bg-blue-800 p-2 rounded")
            span Available reservations
          a(href="#" class="flex items-center space-x-3 text-blue-200 hover:text-white hover:bg-blue-800 p-2 rounded")
            span My Reservations
          a(href="#" class="flex items-center space-x-3 text-blue-200 hover:text-white hover:bg-blue-800 p-2 rounded")
            span Request more time
          a(href="#" class="flex items-center space-x-3 text-blue-200 hover:text-white hover:bg-blue-800 p-2 rounded")
            span Payments
          a(href="#" class="flex items-center space-x-3 text-blue-200 hover:text-white hover:bg-blue-800 p-2 rounded")
            span Settings
          a(href="#" class="flex items-center space-x-3 text-blue-200 hover:text-white hover:bg-blue-800 p-2 rounded")
            span Help

      //- Botón de Logout abajo
      div(class="border-t border-blue-600 pt-4")
        a(href="/logout" class="flex items-center space-x-2 text-white hover:text-red-200 font-medium")
          i(class="fas fa-sign-out-alt rotate-180")
          span Logout

    //- Áreas Principales + Barra Superior
    main(class="flex-1 flex flex-col overflow-y-auto")
      header(class="bg-[#2565ae] text-white h-12 flex items-center justify-end px-6 space-x-4 shadow")
        i(class="far fa-envelope text-xl cursor-pointer")
        i(class="far fa-user-circle text-2xl cursor-pointer")

      //- Contenido de la vista
      div(class="p-6 flex-1")
        block content