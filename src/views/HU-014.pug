//- HU-014 · Settings del conductor (diseño de Sebastián Montoya, conectado al layout y a los datos reales)
extends layouts/app

block content
  div(class="max-w-5xl")

    if successMessage
      .alert.alert-success(class="mb-6")
        i.fas.fa-circle-check
        span= successMessage
    if errorMessage
      .alert.alert-error(class="mb-6")
        i.fas.fa-exclamation-circle
        span= errorMessage

    //- Pestañas de navegación interna (Profile / Password / Vehicles)
    -
      const tabs = [
        { key: 'profile', label: 'Profile', hint: 'Name and phone' },
        { key: 'password', label: 'Password', hint: 'Change your password' },
        { key: 'vehicles', label: 'Vehicles', hint: `${vehicleCount} registered` }
      ]
    div(class="flex gap-6 sm:gap-8 border-b border-gray-200 mb-8")
      each t in tabs
        if t.key === tab
          a(href=`/settings?tab=${t.key}`, class="pb-3 text-sm font-semibold text-blue-600 border-b-2 border-blue-600", aria-current="page")
            | #{t.label}
            span(class="block text-[11px] font-normal text-gray-400")= t.hint
        else
          a(href=`/settings?tab=${t.key}`, class="pb-3 text-sm font-medium text-gray-400 hover:text-gray-600")
            | #{t.label}
            span(class="block text-[11px] font-normal text-gray-300")= t.hint

    if tab === 'profile'
      //- Tarjeta del formulario
      div(id="profile", class="bg-white rounded-2xl border border-gray-100 shadow-sm p-8")

        //- Cabecera del perfil
        div(class="flex items-center gap-4 pb-8 border-b border-gray-100 mb-8")
          div(class="relative")
            div(class="w-16 h-16 rounded-full bg-sky-500 text-white flex items-center justify-center text-xl font-bold shadow-inner")= user.avatar_initials
          div
            h3(class="text-lg font-bold text-gray-900")= user.full_name
            p(class="text-xs text-gray-500") Driver • member since #{memberSince}

        //- Formulario de edición
        form(action="/settings/profile", method="POST")

          div(class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6")
            //- Full name
            div
              label(class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2", for="full_name") Full name
              div(class="relative flex items-center")
                span(class="absolute left-3 text-gray-400") 👤
                input(type="text", id="full_name", name="full_name", value=user.full_name, required, minlength="3", maxlength="100", class="w-full pl-10 pr-4 py-3 bg-gray-50/50 border border-gray-200 rounded-xl text-sm font-medium text-gray-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 transition")

            //- Phone
            div
              label(class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2", for="phone") Phone
              div(class="relative flex items-center")
                span(class="absolute left-3 text-gray-400") 📱
                input(type="tel", id="phone", name="phone", value=user.phone || '', maxlength="20", placeholder="+57 300 000 0000", class="w-full pl-10 pr-4 py-3 bg-gray-50/50 border border-gray-200 rounded-xl text-sm font-medium text-gray-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 transition")

          //- Email (solo lectura)
          div(class="mb-8 relative")
            label(class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2", for="email") Email
            div(class="relative flex items-center")
              span(class="absolute left-3 text-gray-400") ✉️
              input(type="email", id="email", value=user.email, disabled, class="w-full pl-10 pr-24 py-3 bg-gray-50 border border-gray-200 rounded-xl text-sm text-gray-500 cursor-not-allowed")
              if user.email_verified_at
                span(class="absolute right-3 text-xs font-semibold text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-md") Verified
              else
                span(class="absolute right-3 text-xs font-semibold text-amber-600 bg-amber-50 px-2.5 py-1 rounded-md") Not verified
            p(class="text-[11px] text-gray-400 mt-1.5") The email cannot be changed.

          //- Línea divisoria y botones
          div(class="border-t border-gray-100 pt-6 flex items-center justify-end gap-3")
            a(href="/settings", class="px-6 py-2.5 rounded-xl border border-gray-200 text-sm font-semibold text-gray-600 hover:bg-gray-50 transition") Cancel
            button(type="submit", class="px-6 py-2.5 rounded-xl bg-sky-500 text-sm font-semibold text-white hover:bg-sky-600 shadow-lg shadow-sky-500/20 transition") Save changes

    //- Cambio de contraseña (misma regla de HU-002)
    if tab === 'password'
      div(id="password", class="bg-white rounded-2xl border border-gray-100 shadow-sm p-8")
        div(class="pb-6 border-b border-gray-100 mb-8")
          h3(class="text-lg font-bold text-gray-900") Change your password
          p(class="text-xs text-gray-500") You will use the new password the next time you sign in.

        form(action="/settings/password", method="POST", id="passwordForm")
          div(class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6")
            div(class="md:col-span-2")
              label(class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2", for="currentPassword") Current password
              div(class="relative flex items-center")
                span(class="absolute left-3 text-gray-400") 🔒
                input(type="password", id="currentPassword", name="currentPassword", required, autocomplete="current-password", class="w-full pl-10 pr-4 py-3 bg-gray-50/50 border border-gray-200 rounded-xl text-sm font-medium text-gray-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 transition")
            div
              label(class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2", for="newPassword") New password
              div(class="relative flex items-center")
                span(class="absolute left-3 text-gray-400") 🔑
                input(type="password", id="newPassword", name="newPassword", required, minlength="8", autocomplete="new-password", class="w-full pl-10 pr-4 py-3 bg-gray-50/50 border border-gray-200 rounded-xl text-sm font-medium text-gray-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 transition")
            div
              label(class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2", for="confirmPassword") Confirm new password
              div(class="relative flex items-center")
                span(class="absolute left-3 text-gray-400") 🔑
                input(type="password", id="confirmPassword", name="confirmPassword", required, autocomplete="new-password", class="w-full pl-10 pr-4 py-3 bg-gray-50/50 border border-gray-200 rounded-xl text-sm font-medium text-gray-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 transition")

          ul(id="passwordRules", class="grid grid-cols-1 sm:grid-cols-3 gap-2 mb-8 text-xs text-gray-400")
            li(data-rule="length", class="flex items-center gap-2")
              span(class="rule-dot w-2 h-2 rounded-full bg-gray-300")
              | At least 8 characters
            li(data-rule="upper", class="flex items-center gap-2")
              span(class="rule-dot w-2 h-2 rounded-full bg-gray-300")
              | One uppercase letter
            li(data-rule="number", class="flex items-center gap-2")
              span(class="rule-dot w-2 h-2 rounded-full bg-gray-300")
              | One number

          div(class="border-t border-gray-100 pt-6 flex items-center justify-end gap-3")
            a(href="/settings?tab=password", class="px-6 py-2.5 rounded-xl border border-gray-200 text-sm font-semibold text-gray-600 hover:bg-gray-50 transition") Cancel
            button(type="submit", class="px-6 py-2.5 rounded-xl bg-sky-500 text-sm font-semibold text-white hover:bg-sky-600 shadow-lg shadow-sky-500/20 transition") Change password

    //- Vehículos del conductor (los usa HU-004 para iniciar el parqueo)
    if tab === 'vehicles'
      div(id="vehicles", class="bg-white rounded-2xl border border-gray-100 shadow-sm p-8")
        div(class="pb-6 border-b border-gray-100 mb-6")
          h3(class="text-lg font-bold text-gray-900") Your vehicles
          p(class="text-xs text-gray-500") These plates appear when you start a parking session.

        if vehicles.length
          ul(class="divide-y divide-gray-100 mb-8")
            each v in vehicles
              li(class="flex items-center justify-between gap-4 py-4")
                div(class="flex items-center gap-4 min-w-0")
                  div(class="w-11 h-11 rounded-xl bg-sky-50 text-sky-600 flex items-center justify-center shrink-0") 🚗
                  div(class="min-w-0")
                    p(class="text-sm font-bold text-gray-900 tracking-wider")= v.plate
                    p(class="text-xs text-gray-500 truncate")= v.brand_model || 'No brand / model'
                if v.has_active_session
                  span(class="text-xs font-semibold text-amber-600 bg-amber-50 px-2.5 py-1 rounded-md shrink-0") Parked now
                else
                  form(action=`/settings/vehicles/${v.id}/delete`, method="POST", class="shrink-0")
                    button(type="submit", class="px-4 py-2 rounded-xl border border-red-200 text-xs font-semibold text-red-600 hover:bg-red-50 transition") Remove
        else
          div(class="text-center py-8 mb-8 rounded-xl bg-gray-50 border border-dashed border-gray-200")
            p(class="text-sm font-semibold text-gray-700") You have no vehicles yet
            p(class="text-xs text-gray-500") Add your first plate below.

        form(action="/settings/vehicles", method="POST", class="border-t border-gray-100 pt-6")
          p(class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-4") Add a vehicle
          div(class="grid grid-cols-1 md:grid-cols-3 gap-4 items-end")
            div
              label(class="block text-xs font-semibold text-gray-500 mb-2", for="plate") Plate
              input(type="text", id="plate", name="plate", required, maxlength="7", placeholder="ABC123", autocomplete="off", class="w-full px-4 py-3 bg-gray-50/50 border border-gray-200 rounded-xl text-sm font-bold tracking-wider uppercase text-gray-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 transition")
            div
              label(class="block text-xs font-semibold text-gray-500 mb-2", for="brand_model") Brand / model
              input(type="text", id="brand_model", name="brand_model", maxlength="60", placeholder="Mazda 3", class="w-full px-4 py-3 bg-gray-50/50 border border-gray-200 rounded-xl text-sm font-medium text-gray-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 transition")
            button(type="submit", class="px-6 py-3 rounded-xl bg-sky-500 text-sm font-semibold text-white hover:bg-sky-600 shadow-lg shadow-sky-500/20 transition") Add vehicle

block scripts
  script(src="/js/HU-014.js")
