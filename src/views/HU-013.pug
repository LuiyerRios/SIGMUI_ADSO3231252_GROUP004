//- HU-013 · Simulación de pago (diseño de Juan Sebastián Sánchez, conectado al layout y a los datos reales de HU-004)
extends layouts/app

block styles
  link(rel="preconnect", href="https://fonts.googleapis.com")
  link(rel="preconnect", href="https://fonts.gstatic.com", crossorigin)
  link(href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap", rel="stylesheet")
  link(rel="stylesheet", href="/css/HU-013.css")

block content
  .hu013#paymentSimulation(
    data-plate=sim.plate,
    data-zone=sim.zone,
    data-rate-type=sim.rateType,
    data-quantity=sim.quantity,
    data-start=sim.startIso,
    data-end=sim.endIso
  )
    //- Encabezado de página
    .page-header
      .page-header-left
        p.step-label YOUR PAYMENT, STEP BY STEP
        h1.page-title= sim.confirmed ? 'Parking payment receipt' : 'Parking payment simulation'
        p.page-subtitle All the details in one place. Review, confirm, and practice with peace of mind.
      .page-header-right
        span.badge-simulated Simulated payment

    //- Banner verde
    .simulation-alert
      i.fas.fa-flask
      p
        strong Simulation · No real money
        span You are practicing; no charge will be made.

    //- Error al confirmar (lo llena HU-013.js)
    .alert.alert-error#simulationError(class="mb-4", role="alert", hidden)
      i.fas.fa-exclamation-circle
      span#simulationErrorText

    //- Grilla principal
    .simulation-grid
      //- COLUMNA IZQUIERDA
      .left-column
        //- Fila superior (Payment details + Your time)
        .top-cards-row
          //- Tarjeta: Payment details
          .card.payment-details-card
            .card-header-row
              span.card-title Payment details
              span.zone-pill#zonePill Zone #{sim.confirmed ? sim.spaceText : sim.zone + ' · Auto'}
            .vehicle-main
              h3.plate-number= sim.plate
              p.vehicle-desc= sim.vehicleText
            p.parking-zone-footer Parking · Zone #{sim.zone}

          //- Tarjeta: Your time
          .card.your-time-card
            .card-header-row
              span.time-title Your time
              i.far.fa-clock.time-icon
            h3.duration-value= sim.durationText
            .rate-info
              p.rate-label= sim.rateLabel
              p.rate-value= sim.rateText

        //- Fila media (Start -> End)
        .card.time-range-card
          .time-block
            p.time-label Start
            p.time-stamp.js-local-time#startTime(data-time=sim.startIso) —
          .time-arrow
            i.fas.fa-arrow-right
          .time-block.end-block
            p.time-label End
            p.time-stamp.js-local-time#endTime(data-time=sim.endIso) —

        //- Fila inferior (Simulation summary)
        .card.summary-card
          .summary-header
            h3 Simulation summary
            span #{sim.baseDurationText} × #{sim.rateText}

          .summary-breakdown
            .breakdown-item
              p.breakdown-label Subtotal
              p.breakdown-value= sim.subtotalText
            .breakdown-item
              p.breakdown-label= sim.feeLabel
              p.breakdown-value= sim.feeText

          .summary-footer
            .summary-total-label
              p.total-title Simulated total
              p.total-subtitle No real money will be moved.
            .summary-total-amount
              p.total-Big= sim.amountShort
              p.total-currency Colombian Pesos · COP

      //- COLUMNA DERECHA (Recibo)
      .right-column
        .receipt-card
          .receipt-header
            .receipt-brand
              .receipt-logo-icon P
              .receipt-logo-text
                span.text-tech tech
                span.text-parking  parking
            span.receipt-tag SIMULATED

          .receipt-body
            p.receipt-label Simulated receipt
            h3.receipt-code#receiptCode= sim.receiptCode || 'Pending'

            .receipt-list
              .receipt-row
                span.row-label Vehicle
                span.row-value= sim.plate
              .receipt-row
                span.row-label Zone · space
                span.row-value#receiptSpace= sim.spaceText || `${sim.zone} · Assigned on confirm`
              .receipt-row
                span.row-label Duration
                span.row-value= sim.durationText
              .receipt-row
                span.row-label Fee
                span.row-value= sim.rateText
              .receipt-row
                span.row-label Total
                span.row-value#receiptTotal= sim.amountText

            .receipt-detail-box
              p.detail-box-title DETAIL
              p.detail-box-text#receiptDetail Simulated parking charge for zone #{sim.spaceText || sim.zone}. Does not result in any actual account activity.

            .receipt-date-row
              span.row-label Date
              span.row-value.js-local-time#receiptDate(data-time=sim.startIso) —

        .legal-notice
          h4 No valid for banking purposes
          p This receipt is merely a simulation for practice purposes. It does not represent an actual charge and should not be used as a valid proof of payment.

    //- Pie de confirmación
    .confirmation-bar#confirmationBar
      if sim.confirmed
        .confirmation-text
          h4 Payment confirmed
          p= sim.isActive ? `Your parking in space ${sim.spaceText} is active.` : 'This parking session has ended.'
        div(class="flex items-center gap-3 flex-wrap")
          a(href="/payments", class="btn btn-secondary") Back to payments
          if sim.isActive
            a(href="/parking/extend", class="btn btn-primary") Extend time
      else
        .confirmation-text
          h4#confirmTitle Is everything in order?
          p#confirmText You are just practicing. No real money will be moved.
        div(class="flex items-center gap-3 flex-wrap")
          a(href="/parking/start", id="backLink", class="btn btn-secondary") Back
          button.confirm-btn#confirmBtn(type="button")
            span.btn-label Confirm simulation
            i.fas.fa-arrow-right
          div#afterConfirm(class="flex items-center gap-3 flex-wrap", hidden)
            a(href="/payments", class="btn btn-secondary") My payments
            a(href="/parking/extend", class="btn btn-primary") Extend time

block scripts
  script(src="/js/HU-013.js")
