//- HU-015 · Inbox del conductor y del agente: alertas de parqueo, respuestas de soporte y novedades
extends layouts/app

block content
  -
    const typeIcon = { parking_alert: 'fa-clock', support_reply: 'fa-comment-dots' }
    const typeBox = { parking_alert: 'bg-warning/12 text-warning', support_reply: 'bg-accent/12 text-accent' }
    const iconFor = (t) => typeIcon[t] || 'fa-bullhorn'
    const boxFor = (t) => typeBox[t] || 'bg-tech/12 text-tech'
    const filters = [['all', 'All'], ['unread', 'Unread'], ['alerts', 'Alerts'], ['support', 'Support']]

  if errorMessage
    .alert.alert-error
      i.fas.fa-exclamation-circle
      span= errorMessage

  else
    div(class="grid grid-cols-12 gap-6 items-start")
      //- Columna izquierda: lista de mensajes
      section(class="card col-span-12 lg:col-span-5 p-5" + (openedFromList ? ' hidden lg:block' : ''))
        header(class="flex items-center justify-between gap-3 mb-4")
          div(class="flex items-center gap-2")
            h2(class="text-lg font-bold text-ink") Inbox
            if unreadCount > 0
              span.pill.pill-accent #{unreadCount} unread
            else
              span.pill.pill-muted All read
          form(action=`/inbox/read-all?filter=${activeFilter}`, method="POST")
            button(type="submit", class="text-xs font-semibold text-primary hover:underline") Mark all as read

        nav(class="flex items-center gap-2 flex-wrap mb-4", aria-label="Filter messages")
          each f in filters
            a(href=`/inbox?filter=${f[0]}`, class="chip" + (activeFilter === f[0] ? ' active' : ''))= f[1]

        if notifications.length === 0
          .empty-state
            i.far.fa-envelope-open
            p= activeFilter === 'all' ? 'Your inbox is empty.' : 'No messages in this filter.'
        else
          ul(class="flex flex-col gap-1")
            each notif in notifications
              - const isSelected = selectedNotification && selectedNotification.id === notif.id
              - const isUnread = !notif.readAt
              li
                a(
                  href=`/inbox?filter=${activeFilter}&id=${notif.id}`,
                  class="flex items-start gap-3 rounded-xl p-3 border-l-[3px] transition " + (isSelected ? 'bg-surface-soft border-accent' : 'border-transparent hover:bg-surface-soft')
                )
                  span(class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0 " + boxFor(notif.type))
                    i(class="fas " + iconFor(notif.type))
                  div(class="flex-1 min-w-0")
                    div(class="flex items-center justify-between gap-2")
                      p(class="text-sm text-ink truncate " + (isUnread ? 'font-bold' : 'font-medium'))= notif.title
                      span(class="text-[11px] text-muted shrink-0")= notif.formattedDate
                    p(class="text-xs text-muted truncate mt-0.5")= notif.body
                  if isUnread
                    span(class="w-2 h-2 rounded-full bg-accent mt-2 shrink-0", aria-label="Unread")

      //- Columna derecha: panel de lectura
      section(class="card col-span-12 lg:col-span-7 p-6 min-h-[320px]" + (openedFromList ? '' : ' hidden lg:block'))
        if selectedNotification
          - const n = selectedNotification
          a(href=`/inbox?filter=${activeFilter}`, class="lg:hidden inline-flex items-center gap-2 text-xs font-semibold text-primary mb-4")
            i.fas.fa-arrow-left
            span Back to inbox

          header(class="flex items-start justify-between gap-4 pb-5 border-b border-line")
            div(class="flex items-start gap-4 min-w-0")
              span(class="w-12 h-12 rounded-2xl flex items-center justify-center text-lg shrink-0 " + boxFor(n.type))
                i(class="fas " + iconFor(n.type))
              div(class="min-w-0")
                h3(class="text-xl font-bold text-ink")= n.title
                p(class="text-xs text-muted mt-1") #{n.senderName} · #{n.formattedDetailDateTime}
            if n.type === 'parking_alert'
              span.pill.pill-warning(class="shrink-0") Parking alert
            else if n.type === 'support_reply'
              span.pill.pill-accent(class="shrink-0") Support reply
            else
              span.pill.pill-info(class="shrink-0") News

          div(class="pt-5 flex flex-col gap-5")
            p(class="text-sm text-ink leading-relaxed whitespace-pre-line")= n.body

            if n.type === 'support_reply' && n.originalReport
              div(class="rounded-xl bg-surface-soft border border-line p-4")
                p(class="text-xs font-semibold text-muted flex items-center gap-2 mb-1")
                  i.fas.fa-reply
                  span Your report #{n.originalReport.code}
                p(class="text-sm text-ink")= n.originalReport.description

            if n.type === 'parking_alert'
              div(class="rounded-2xl bg-warning/10 border border-warning/30 p-4 flex items-center justify-between gap-4 flex-wrap")
                div(class="flex items-center gap-3")
                  i(class="fas fa-stopwatch text-2xl text-warning")
                  div
                    if n.sessionInfo
                      p(class="text-sm font-bold text-ink") 10 min left · #{n.sessionInfo.spaceId}
                      p(class="text-xs text-muted") #{n.sessionInfo.plate} · ends at #{n.sessionInfo.endTime}
                    else
                      p(class="text-sm font-bold text-ink") Time is running out
                      p(class="text-xs text-muted") Extend your parking session now to keep your spot and prevent penalties.
                a(href=n.link || '/parking/extend', class="btn btn-primary")
                  span Extend time
                  i.fas.fa-arrow-right
        else
          .empty-state
            i.far.fa-envelope
            p Select a message to view details.
