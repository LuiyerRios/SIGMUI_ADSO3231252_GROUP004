//- src/views/partials/admin-sidebar.pug
- const userName = (currentUser && currentUser.name) ? currentUser.name : 'Admin SIGMUI'
- const nameParts = userName.trim().split(/\s+/)
- const initials = nameParts.length >= 2 ? (nameParts[0].charAt(0) + nameParts[1].charAt(0)).toUpperCase() : userName.substring(0, 2).toUpperCase()

aside.admin-sidebar#adminSidebar
  .sidebar-header
    .logo-group
      .logo-icon P
      .logo-text
        span.logo-tech tech 
        span.logo-parking parking
    button.btn-toggle-sidebar#toggleSidebar(type="button", title="Toggle Sidebar") «

  nav.sidebar-menu
    .menu-label MENU
    a.menu-item(href="/admin", class=active === 'zones' ? 'active' : '')
      i.fas.fa-th-large
      span.menu-text Parking zones
    a.menu-item(href="/admin/dashboard", class=active === 'dashboard' ? 'active' : '')
      i.fas.fa-chart-pie
      span.menu-text Dashboard
    a.menu-item(href="#", class=active === 'users' ? 'active' : '')
      i.fas.fa-users
      span.menu-text Manage users
    a.menu-item(href="/admin/payments", class=active === 'payments' ? 'active' : '')
      i.fas.fa-receipt
      span.menu-text Payment history
    a.menu-item(href="/admin/help-reports", class=active === 'reports' ? 'active' : '')
      i.fas.fa-headset
      span.menu-text Help reports
    a.menu-item(href="/admin/settings", class=active === 'settings' ? 'active' : '')
      i.fas.fa-cog
      span.menu-text Settings

  .sidebar-footer
    .user-profile-card
      .avatar-circle= initials
      .user-info
        strong.user-name= userName
        span.user-role Administrator
    a.btn-sidebar-logout(href="/logout", title="Logout")
      i.fas.fa-sign-out-alt
      span.menu-text Logout