//- HU-006 · Verificación de placa (diseño del equipo, conectado a GET /api/plates/:plate/status)
extends layouts/app

block styles
  link(rel="stylesheet", href="/css/HU-006.css")

block content
  .hu006
    main.container
      section.inspection-agent
        img.inspection-agent__icon(src="/img/transito.png", alt="Transit agent")
        h2.inspection-agent__title Vehicle Inspection

      form.inspection-form#plateForm(novalidate)
        label.inspection-form__label(for="plate-input") Plate to be checked
        .plate-input
          img.plate-input__flag(src="/img/colombia.png", alt="Colombia")
          input#plate-input.plate-input__field(
            type="text",
            name="plate",
            placeholder="ABC123",
            maxlength="7",
            autocomplete="off",
            value=initialPlate,
            aria-describedby="plate-error",
            required
          )
        p#plate-error.error-message(role="alert", aria-live="polite")
        button.btn-check#checkBtn(type="submit") CHECK

      //- Resultado de la consulta (lo llena HU-006.js con los datos de la BD)
      section#result.results-area(aria-live="polite")

block scripts
  script(src="/js/HU-006.js")
