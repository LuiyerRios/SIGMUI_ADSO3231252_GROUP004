extends layouts/app

block content
  - const currentRange = range || 'today'

  div(class="flex flex-col gap-6", id="dashboardContainer")
    if errorMessage
      div(class="alert alert-error")
        i(class="fas fa-exclamation-circle")
        span= errorMessage

    //- 1. Filtros: rangos rápidos o cualquier periodo, y exportación (HU-008 #43)
    - const qs = currentRange === 'custom' ? `from=${period.from}&to=${period.to}` : `range=${currentRange}`
    div(class="flex items-end justify-between flex-wrap gap-4")
      div(class="flex items-end gap-3 flex-wrap")
        div(class="flex items-center gap-2 flex-wrap")
          a.js-loading(href="/admin/dashboard?range=today", class=currentRange === 'today' ? 'chip active' : 'chip') Today
          a.js-loading(href="/admin/dashboard?range=7d", class=currentRange === '7d' ? 'chip active' : 'chip') Last 7 days
          a.js-loading(href="/admin/dashboard?range=30d", class=currentRange === '30d' ? 'chip active' : 'chip') Last 30 days
        form(method="GET", action="/admin/dashboard", id="periodForm", class="flex items-end gap-2 flex-wrap")
          div(class="flex flex-col")
            label(for="dashFrom", class="text-[11px] font-semibold text-muted mb-1") From
            input.input(type="date", id="dashFrom", name="from", value=period ? period.from : '', required, class="w-[150px] py-1.5 text-xs")
          div(class="flex flex-col")
            label(for="dashTo", class="text-[11px] font-semibold text-muted mb-1") To
            input.input(type="date", id="dashTo", name="to", value=period ? period.to : '', required, class="w-[150px] py-1.5 text-xs")
          button.btn.btn-primary(type="submit", class="py-1.5 px-3 text-xs")
            i(class="fas fa-filter text-xs")
            span Apply

      div(class="flex items-center gap-2")
        a(href=`/admin/dashboard/export?format=excel&${qs}`, class="btn btn-secondary py-1.5 px-3 text-xs js-export")
          i(class="fas fa-file-excel text-xs")
          span Excel
        a(href=`/admin/dashboard/export?format=pdf&${qs}`, class="btn btn-secondary py-1.5 px-3 text-xs js-export")
          i(class="fas fa-file-pdf text-xs")
          span PDF

    //- Indicador de carga mientras se consulta el periodo (HU-008 #43)
    div(id="dashLoading", class="alert alert-info", hidden)
      i(class="fas fa-spinner fa-spin")
      span Loading the report…

    if period
      p(class="text-xs text-muted -mt-3") Showing #{period.from} to #{period.to}

    if data && data.incompleteSessions > 0
      div(class="alert alert-error")
        i(class="fas fa-triangle-exclamation")
        span Some data is incomplete: #{data.incompleteSessions} session(s) have no space, amount or valid times and were not added to the totals.

    if noData
      div(class="card")
        div(class="empty-state")
          i(class="fas fa-chart-line")
          p No data available

    //- 2. Tarjetas de Estadísticas Principales
    div(class="stat-grid")
      div(class="stat-card")
        div(class="flex items-center gap-3 mb-2")
          div(class="w-10 h-10 rounded-xl bg-accent/10 text-accent flex items-center justify-center shrink-0")
            i(class="fas fa-dollar-sign")
          div(class="flex flex-col")
            span(class="card-label") Revenue
            strong(class="card-value")= formattedRevenue || '$0 COP'
        span(class="text-xs text-muted") Parking + extensions

      div(class="stat-card")
        div(class="flex items-center gap-3 mb-2")
          div(class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center shrink-0")
            i(class="fas fa-calendar-check")
          div(class="flex flex-col")
            span(class="card-label") Sessions
            strong(class="card-value")= data ? data.sessions : 0
        span(class="text-xs text-muted") Paid parking sessions

      div(class="stat-card")
        div(class="flex items-center gap-3 mb-2")
          div(class="w-10 h-10 rounded-xl bg-warning/10 text-warning flex items-center justify-center shrink-0")
            i(class="fas fa-clock")
          div(class="flex flex-col")
            span(class="card-label") Avg. duration
            strong(class="card-value")= formattedAvgDuration || '0m'
        span(class="text-xs text-muted") Max allowed 4 h

      div(class="stat-card")
        div(class="flex items-center gap-3 mb-2")
          div(class="w-10 h-10 rounded-xl bg-danger/10 text-danger flex items-center justify-center shrink-0")
            i(class="fas fa-file-invoice")
          div(class="flex flex-col")
            span(class="card-label") Fines issued
            strong(class="card-value")= data ? data.finesIssued : 0
        span(class="text-xs text-muted") Issued by traffic agents

    //- 3. Layout de Gráficos y Tablas
    div(class="grid grid-cols-12 gap-6 items-start")
      //- Ocupación por Hora (CSS Bars Chart)
      div(class="card col-span-12 xl:col-span-5")
        div(class="card-header flex items-center justify-between")
          div
            h2(class="card-title") Occupancy by hour
            p(class="card-subtitle") Hourly usage on #{period ? period.to : 'today'}
          span(class="text-xs font-semibold text-accent") Peak #{data ? data.peakHourText : '—'}

        if data && data.occupancyByHour && data.occupancyByHour.length > 0
          div(class="flex items-end justify-between gap-1.5 h-48 pt-6 pb-2 border-b border-line px-2")
            each item in data.occupancyByHour
              - const isPeak = data.peakHour !== null && item.hour === data.peakHour
              div(class="flex flex-col items-center gap-1 flex-1 h-full justify-end")
                span(class="text-[10px] font-bold text-muted") #{item.percent}%
                div(
                  class=isPeak ? "w-full bg-accent rounded-t-md transition-all" : "w-full bg-tech/40 rounded-t-md transition-all hover:bg-tech",
                  style=`height: ${Math.max(item.percent, 4)}%`
                )
                span(class="text-[10px] text-muted font-medium mt-1")= item.label
        else
          div(class="empty-state")
            i(class="fas fa-chart-bar")
            p No hourly occupancy data available for today.

      //- Ingresos por Zona (Horizontal Progress Bars)
      div(class="card col-span-12 md:col-span-6 xl:col-span-3")
        div(class="card-header")
          h2(class="card-title") Revenue by zone
          p(class="card-subtitle") Distribution across blue zones

        if data && data.revenueByZone && data.revenueByZone.length > 0
          div(class="flex flex-col gap-4 py-2")
            each z in data.revenueByZone
              div(class="flex flex-col gap-1.5")
                div(class="flex justify-between items-center text-xs")
                  span(class="font-bold text-ink") Zone #{z.zone}
                  span(class="font-semibold text-muted")= z.amountText
                div(class="w-full bg-surface-soft h-2.5 rounded-full overflow-hidden")
                  div(
                    class="bg-gradient-to-r from-primary to-tech h-full rounded-full",
                    style=`width: ${z.percent}%`
                  )
        else
          div(class="empty-state")
            i(class="fas fa-coins")
            p No revenue data by zone.

      //- HU-008 (#43): % de zonas con ocupación baja, media y alta (regla de HU-003)
      div(class="card col-span-12 md:col-span-6 xl:col-span-4")
        div(class="card-header")
          h2(class="card-title") Zones by occupancy
          p(class="card-subtitle") Right now · Low under 30%, High 70% or more
        if data && data.zoneLevels && data.zoneLevels.length
          div(class="flex flex-col gap-4 py-2")
            each l in data.zoneLevels
              - const bar = l.level === 'High' ? 'bg-danger' : l.level === 'Medium' ? 'bg-warning' : 'bg-success'
              div(class="flex flex-col gap-1.5")
                div(class="flex justify-between items-center text-xs")
                  span(class="font-bold text-ink")= l.level
                  span(class="font-semibold text-muted") #{l.count} zone#{l.count === 1 ? '' : 's'} · #{l.percent}%
                div(class="w-full bg-surface-soft h-2.5 rounded-full overflow-hidden")
                  div(class=`${bar} h-full rounded-full`, style=`width: ${l.percent}%`)
        else
          div(class="empty-state")
            i(class="fas fa-layer-group")
            p No data available

      //- Últimas Sesiones (Tabla Responsive)
      div(class="card col-span-12")
        div(class="card-header")
          h2(class="card-title") Latest sessions
          p(class="card-subtitle") Recent activity in system

        if data && data.latestSessions && data.latestSessions.length > 0
          div(class="table-responsive")
            table(class="table")
              thead
                tr
                  th PLATE
                  th SPACE
                  th TIME
                  th AMOUNT
              tbody
                each sess in data.latestSessions
                  tr
                    td(data-label="PLATE", class="font-bold text-ink")= sess.plate
                    td(data-label="SPACE")= sess.spaceId
                    td(data-label="TIME")= sess.durationText
                    td(data-label="AMOUNT", class="font-semibold text-ink")= sess.amountText
        else
          div(class="empty-state")
            i(class="fas fa-car-side")
            p No recent sessions recorded.
block scripts
  script(src="/js/HU-008.js")
