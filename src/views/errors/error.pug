//- Página de error (403/404/500) con Tailwind v4 compilado en /css/app.css
doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title= title
    link(rel="stylesheet", href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap")
    link(rel="stylesheet", href="/css/app.css")
  body(class="min-h-screen flex items-center justify-center bg-[#E6F2F8] font-sans p-4")
    div(class="bg-white rounded-xl shadow-card p-8 text-center max-w-md w-full")
      h1(class="text-4xl font-bold text-[#2565AE] mb-2")= code
      p(class="text-gray-700 mb-6")= message
      a(href="/" class="inline-block bg-[#2565AE] text-white px-6 py-2 rounded-full") Go to home
