doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title= title || "Email Verification | SIGMUI"
    link(rel="stylesheet", href="/css/HU-012.css")
    script(src="https://cdn.tailwindcss.com")
  body(class="min-h-screen flex flex-col justify-between items-center relative bg-gradient-to-br from-slate-800 to-slate-900")

    main(class="flex-grow flex items-center justify-center w-full px-4 py-8")
      div(class="w-full max-w-[440px] bg-[var(--color-card-bg,#969696)] rounded-xl overflow-hidden shadow-2xl")

        header(class="bg-[#2565AE] text-center py-5")
          h1(class="text-3xl font-bold tracking-tight text-white")
            span(class="text-[#64b5f6]") tech 
            | parking

        div(class="p-8 flex flex-col items-center gap-6 text-center")

          if status === 'verified' || status === 'already_verified'
            div(class="w-16 h-16 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center text-3xl font-bold") ✓
          else if status === 'expired' || status === 'error'
            div(class="w-16 h-16 rounded-full bg-amber-500/20 text-amber-400 flex items-center justify-center text-3xl font-bold") !
          else
            div(class="w-16 h-16 rounded-full bg-red-500/20 text-red-400 flex items-center justify-center text-3xl font-bold") ✕

          p(class="text-gray-900 font-semibold text-lg leading-relaxed")= message

          if status === 'expired' || showResendForm
            form(action="/verify-email/resend", method="POST", class="w-full flex flex-col gap-3 mt-2")
              label(for="email", class="text-xs font-bold text-gray-900 uppercase tracking-wider text-left") Email Address
              input(
                type="email",
                id="email",
                name="email",
                value=resendEmail || '',
                placeholder="correo@ejemplo.com",
                required,
                class="w-full px-4 py-3 bg-[#D9D9D9] text-gray-800 placeholder-gray-500 rounded-lg outline-none border-none text-base focus:ring-2 focus:ring-[#2565AE]"
              )
              button(
                type="submit",
                class="w-full bg-[#2565AE] hover:opacity-90 text-white font-medium py-3 rounded-full text-base transition duration-200 cursor-pointer shadow-md mt-1"
              ) Resend verification email

          a(
            href="/login",
            class="w-full bg-[#2565AE] hover:opacity-90 text-white font-medium py-3 rounded-full text-lg transition duration-200 text-center block shadow-md"
          ) Sign in

    footer(class="pb-6 text-center text-white font-medium text-lg drop-shadow-md")
      p CopyRight©Team_004