doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Simulacion de pago de estacionamiento - Tech Parking
    link(rel="stylesheet", href="/src/output.css")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css")

  body.bg-slate-50.flex.h-screen.font-sans.text-gray-800
    //- Menú Lateral (Sidebar)
    aside.w-64.bg-[#245389].text-white.flex.flex-col.justify-between
      div
        //- Espacio del logo superior izquierdo
        div.h-20.flex.items-center.px-6
          div.w-10.h-10.bg-blue-400.rounded-xl.shadow-[0_0_15px_rgba(96,165,250,0.6)]
          
        //- Enlaces de Navegación
        nav.mt-4.flex.flex-col.gap-2.px-3
          a.flex.items-center.gap-3.px-4.py-3.rounded-lg.text-blue-100.hover:bg-white.hover:bg-opacity-10.transition(href="#")
            i.fas.fa-home.w-5
            span.text-sm Inicio
          a.flex.items-center.gap-3.px-4.py-3.rounded-lg.text-blue-100.hover:bg-white.hover:bg-opacity-10.transition(href="#")
            i.far.fa-play-circle.w-5
            span.text-sm Iniciar estacionamiento
          a.flex.items-center.gap-3.px-4.py-3.rounded-lg.text-blue-100.hover:bg-white.hover:bg-opacity-10.transition(href="#")
            i.far.fa-clock.w-5
            span.text-sm Extender tiempo
          a.flex.items-center.gap-3.px-4.py-3.rounded-lg.bg-white.bg-opacity-10.text-white.border-l-4.border-blue-400(href="#")
            i.far.fa-credit-card.w-5
            span.text-sm.font-medium Pagos
          a.flex.items-center.gap-3.px-4.py-3.rounded-lg.text-blue-100.hover:bg-white.hover:bg-opacity-10.transition(href="#")
            i.far.fa-question-circle.w-5
            span.text-sm Ayuda
            
      //- Perfil de Usuario
      div.p-4.mb-6.mx-3.bg-[#1E4675].rounded-xl
        div.flex.items-center.gap-3.mb-4
          div.w-10.h-10.bg-white.text-[#245389].rounded-full.flex.items-center.justify-center.font-bold.text-sm LR
          div
            p.text-sm.font-bold Luiyer Rios
            p.text-xs.text-blue-200 Conductor
        button.w-full.flex.items-center.justify-center.gap-2.py-2.bg-white.bg-opacity-10.hover:bg-opacity-20.rounded-lg.text-sm.transition
          i.fas.fa-sign-out-alt
          span Cerrar sesión

    //- Contenido Principal
    main.flex-1.flex.flex-col.overflow-hidden
      //- Cabecera Superior
      header.h-16.bg-white.flex.items-center.justify-between.px-8.border-b.border-gray-200
        div.flex.items-center.gap-2
          div.w-8.h-8.bg-[#4A90E2].text-white.rounded-lg.flex.items-center.justify-center.font-bold P
          span.font-bold.text-[#4A90E2] tech
          span.font-bold.text-gray-800 parking
          
        div.flex-1.max-w-xl.mx-8
          div.relative
            i.fas.fa-search.absolute.left-4.top-2.5.text-gray-400.text-sm
            input.w-full.bg-gray-50.border.border-gray-200.rounded-lg.py-2.pl-10.pr-4.text-sm.focus:outline-none.focus:border-blue-400(type="text" placeholder="Buscar espacio o placa...")
            
        div.flex.items-center.gap-4.text-gray-500
          button.w-8.h-8.rounded-full.hover:bg-gray-100.flex.items-center.justify-center.transition: i.far.fa-moon
          button.w-8.h-8.rounded-full.hover:bg-gray-100.flex.items-center.justify-center.transition: i.far.fa-envelope
          button.w-8.h-8.rounded-full.hover:bg-gray-100.flex.items-center.justify-center.transition: i.far.fa-bell

      //- Contenido Scrolleable
      div.flex-1.overflow-y-auto.p-8
        div.max-w-5xl.mx-auto.bg-white.rounded-2xl.shadow-sm.border.border-gray-100.p-8
          
          div.mb-6
            h1.text-2xl.font-bold.text-gray-900.mb-2 Simulación de pago de estacionamiento
            p.text-gray-500.text-sm Revisa los datos del cobro, el resumen y el comprobante simulado en una sola pantalla.
            
          div.bg-[#F0F5FF].text-[#4A90E2].px-4.py-3.rounded-lg.flex.items-center.gap-3.mb-8
            i.fas.fa-flask
            span.text-sm.font-medium Simulación - Sin dinero real
            
          div.grid.grid-cols-1.lg:grid-cols-2.gap-8
            //- Columna Izquierda
            div.flex.flex-col.gap-6
              //- Caja de Datos del pago
              div.border.border-gray-100.rounded-xl.p-6.shadow-sm
                h2.text-lg.font-bold.text-gray-900.mb-1 Datos del pago
                p.text-sm.text-gray-500.mb-6 Revisa la información del cobro antes de generar el comprobante simulado.
                
                div.grid.grid-cols-2.gap-y-6.gap-x-4
                  div
                    p.text-[11px].font-bold.text-gray-400.uppercase.tracking-wider.mb-1 VEHÍCULO
                    p.text-sm.font-bold.text-gray-800 KJT-482 · Mazda 3 · Blanco
                  div
                    p.text-[11px].font-bold.text-gray-400.uppercase.tracking-wider.mb-1 ZONA
                    p.text-sm.font-bold.text-gray-800 B · B14
                  div
                    p.text-[11px].font-bold.text-gray-400.uppercase.tracking-wider.mb-1 DURACIÓN
                    p.text-sm.font-bold.text-gray-800 2 h
                  div
                    p.text-[11px].font-bold.text-gray-400.uppercase.tracking-wider.mb-1 TARIFA
                    p.text-sm.font-bold.text-gray-800 $2,500 / hora
                  div
                    p.text-[11px].font-bold.text-gray-400.uppercase.tracking-wider.mb-1 INICIO
                    p.text-sm.font-bold.text-gray-800 20 oct · 09:12
                  div
                    p.text-[11px].font-bold.text-gray-400.uppercase.tracking-wider.mb-1 FIN
                    p.text-sm.font-bold.text-gray-800 20 oct · 11:12
                  div
                    p.text-[11px].font-bold.text-gray-400.uppercase.tracking-wider.mb-1 CONCEPTO
                    p.text-sm.font-bold.text-gray-800 Estacionamiento · Zona B
                  div
                    p.text-[11px].font-bold.text-gray-400.uppercase.tracking-wider.mb-1 TIPO
                    p.text-sm.font-bold.text-gray-800 Pago simulado
                    
              //- Caja de Resumen
              div.border.border-gray-100.rounded-xl.p-6.shadow-sm
                h2.text-lg.font-bold.text-gray-900.mb-1 Resumen
                p.text-sm.text-gray-500.mb-6 Revisa el cobro antes de confirmar la simulación.
                
                div.flex.flex-col.gap-4
                  div.flex.justify-between.items-center.pb-4.border-b.border-gray-100
                    span.text-sm.text-gray-500 Tarifa por hora
                    span.text-sm.font-bold.text-gray-900 $2,500 COP
                  div.flex.justify-between.items-center.pb-4.border-b.border-gray-100
                    span.text-sm.text-gray-500 Duración
                    span.text-sm.font-bold.text-gray-900 2 h
                  div.flex.justify-between.items-center.pb-4.border-b.border-gray-100
                    span.text-sm.text-gray-500 Subtotal
                    span.text-sm.font-bold.text-gray-900 $5,000 COP
                  div.flex.justify-between.items-center.pb-4.border-b.border-gray-100
                    span.text-sm.text-gray-500 Cargo simulado
                    span.text-sm.font-bold.text-gray-900 $1,000 COP
                  div.flex.justify-between.items-center.pt-2
                    span.text-base.font-bold.text-gray-900 Total
                    span.text-2xl.font-bold.text-gray-900 $6,000 COP
                    
            //- Columna Derecha
            div.flex.flex-col.gap-6
              //- Tarjeta Comprobante Simulado (Gradiente)
              div.bg-gradient-to-br.from-[#2563EB].to-[#06B6D4].rounded-xl.p-6.text-white.shadow-lg
                div.flex.justify-between.items-start.mb-6
                  div.flex.items-center.gap-2
                    div.w-7.h-7.bg-white.bg-opacity-20.rounded.flex.items-center.justify-center.font-bold.text-sm P
                    span.font-bold.text-lg tech parking
                  div.bg-white.bg-opacity-20.px-3.py-1.rounded-full.text-[10px].font-bold.tracking-wider SIMULADO
                
                p.text-blue-100.text-sm.mb-1 Comprobante simulado
                h3.text-4xl.font-bold.mb-10 TP-0318
                
                div.flex.flex-col.gap-3.mb-6
                  div.flex.justify-between.text-sm
                    span.text-blue-100 Vehículo
                    span.font-bold KJT-482
                  div.flex.justify-between.text-sm
                    span.text-blue-100 Zona
                    span.font-bold B · B14
                  div.flex.justify-between.text-sm
                    span.text-blue-100 Duración
                    span.font-bold 2 h
                  div.flex.justify-between.text-sm
                    span.text-blue-100 Tarifa
                    span.font-bold $2,500 / hora
                  div.flex.justify-between.text-sm.mt-2
                    span.text-blue-100 Total
                    span.font-bold $6,000 COP
                    
                div.bg-white.bg-opacity-10.rounded-lg.p-4.mb-6
                  p.text-[10px].text-blue-200.uppercase.tracking-wider.mb-2.font-bold DETALLE
                  p.text-sm.leading-relaxed Cobro simulado por estacionamiento en zona B - B14. No genera movimiento real en la cuenta.
                  
                div.flex.justify-between.items-center.text-xs.text-blue-100
                  span Fecha
                  span.font-bold 20 oct · 09:12
                  
              //- Caja de Advertencia
              div.border.border-gray-100.rounded-xl.p-5.bg-gray-50
                h4.text-sm.font-bold.text-[#245389].mb-2 Sin validez bancaria
                p.text-xs.text-gray-500.leading-relaxed Este comprobante es solo una simulación para práctica. No representa un cobro real y no debe usarse como justificante válido.

          //- Pie de página / Botón de Acción
          div.mt-10.flex.flex-col.items-end.gap-3
            button.bg-[#1E3A5F].hover:bg-[#152B47].text-white.px-6.py-3.rounded-lg.font-medium.flex.items-center.gap-2.transition.shadow-md
              span Confirmar simulación
              i.fas.fa-arrow-right.text-sm
            p.text-[11px].text-gray-400.text-center.w-full.mt-4 Solo estás practicando. No se moverá dinero real.