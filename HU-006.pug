doctype html
html(lang="es")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title Vehicle Inspection - SIGMUI

        link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css")
        link(rel="stylesheet", href="public/css/style.css")

    body

        header.header
            button.header__back(aria-label="Volver")
                i.fa-solid.fa-arrow-left

            h1.header__title
                span tech
                |  parking

        main.container

            section.inspection-agent
                img.inspection-agent__icon(src="public/img/transito.png", alt="Agente de Transito")
                h2.inspection-agent__title Vehicle Inspection

            form.inspection-form(data-n8n-form="vehicle-check")

                label.inspection-form__label(for="plate-input") Plate to be checked

                .plate-input
                    img.plate-input__flag(src="public/img/colombia.png", alt="Bandera")

                    input#plate-input.plate-input__field(
                        type="text"
                        placeholder="ABC1098"
                        required
                    )

                button.btn-check(type="button", onclick="checkPlate()") CHECK

            section#result.results-area

                article.card.card--success(data-status="valid")

                    .card__icon.icon-status--success
                        i.fa-solid.fa-check

                    .card__info
                        h3 PAYMENT PROCESSED
                        p Zone A1
                        p 14:30 - 16:30 (2h)
                        p Time remaining: 45 min

                    span.badge.badge--valid Valid

                article.card.card--error(data-status="expired")

                    .card__icon.icon-status--error
                        i.fa-solid.fa-xmark

                    .card__info
                        h3 PAYMENT INACTIVE
                        p Zone B2
                        p 10:00 - 12:00 (1h)
                        p Expired 1 hour and 40 minutes ago

                    span.badge.badge--expired Expired

                h3.results-area__subtitle NOT REGISTERED

                article.card.card--neutral(data-status="not-registered")

                    .card__icon.icon-status--neutral
                        i.fa-solid.fa-circle-xmark

                    .card__info
                        p The license plate has no active payments

        script(src="HU-006.js")